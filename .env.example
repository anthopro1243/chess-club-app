# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard -> Project Settings -> API). Both are safe to expose
# in the browser bundle — the anon key only does what supabase/schema.sql's
# Row Level Security policies allow, which is nothing until you're signed
# in. Leave both unset to run entirely on browser-local storage, no backend
# required.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
