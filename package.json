{
  "name": "chess-club-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chess club website \u2014 playable board plus the club app shell.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test 'src/**/*.test.js' && node scripts/sql-tests.mjs && node supabase/rls-test.mjs",
    "test:rls": "node supabase/rls-test.mjs",
    "test:engine": "node --test src/engine/stockfishClient.engine-test.js src/analysis/analyzeGame.engine-test.js",
    "test:all": "npm test && npm run test:engine",
    "test:sql": "node scripts/sql-tests.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/oswald": "^5.2.5",
    "@fontsource/public-sans": "^5.2.5",
    "@supabase/supabase-js": "^2.116.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "vite": "^7.3.8"
  },
  "engines": {
    "node": ">=22"
  }
