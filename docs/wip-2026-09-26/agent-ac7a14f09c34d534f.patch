+
+/* ── openingPlay ──────────────────────────────────────────────────────────── */
+
+test('openingPlay grades only this side’s opening moves and finds the first real mistake', () => {
+  const plies = [
+    ...openingPlies('w', { slipAtPly: 13 }),
