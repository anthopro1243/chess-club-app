+import { useEffect, useMemo, useRef, useState } from 'react';
+import GameReview from './GameReview.jsx';
+import { GAME_MODE_LABEL } from '../data/gamesStore.js';
+import { canViewAnalysis, NOT_ENOUGH } from '../analysis/presentation.js';
+import { DEFAULT_PLIES, DEFAULT_MIN_GAMES } from '../analysis/repertoire.js';
+import {
+  buildRepertoireView,
+  scoreText,
+  recordText,
+  accuracyText,
+  slipText,
+  sideLabel,
+  GROUPING_PLIES,
+  MIN_RESULT_GAMES,
+  MIN_ANALYSED_GAMES,
+  OPENING_ACCURACY_FROM_MOVE,
+  OPENING_ACCURACY_TO_MOVE,
+} from '../analysis/repertoireView.js';
+import '../styles/repertoire.css';
+
+/*
+ * RepertoirePanel — the openings one player actually plays, as White and as
+ * Black, and where they tend to go wrong.
+ *
+ * All the deciding happens in repertoireView.js (tested): which games count,
+ * which side of the analysis may be read, and when a result is too thin to
+ * show. This file only lays it out.
+ *
+ * Two hosts. The Roster detail (coach view) embeds its own GameReview for the
+ * example game. My games already has a game viewer, so it passes onOpenGame
+ * and the example opens there: two GameReviews on one page would both listen
+ * to the arrow keys.
+ *
+ * `audience` changes wording, never permissions. The player's version leads
+ * with what is going well and names ONE line to look at, the way
+ * presentation.js's playerSummary names one priority; the coach sees every
+ * line that is scoring below half.
+ */
+
+const COACH_WEAK_LIMIT = 3;
+
+const plural = (n, one, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;
+const capitalise = (text) => (text ? text[0].toUpperCase() + text.slice(1) : text);
+const OUTCOME_LABEL = { won: 'Won', drew: 'Drew', lost: 'Lost' };
+
+export default function RepertoirePanel({
+  playerId,
+  games,
+  analyses,
+  viewer,
+  audience = 'player',
+  onOpenGame = null,
+}) {
+  const [plies, setPlies] = useState(DEFAULT_PLIES);
+  // { side, key, gameId, ply } for the line whose games are on show.
+  const [selected, setSelected] = useState(null);
+  const exampleRef = useRef(null);
+
+  const view = useMemo(
+    () => buildRepertoireView({ viewer, games, analyses, playerId, plies }),
+    [viewer?.role, viewer?.playerId, games, analyses, playerId, plies],
+  );
+
+  // A new grouping makes new lines; the old selection may not exist any more.
+  useEffect(() => setSelected(null), [plies, playerId]);
+
+  const selectedLine = useMemo(() => {
+    if (!view || !selected) return null;
+    return view.sides[selected.side].lines.find((l) => l.key === selected.key) || null;
+  }, [view, selected]);
+
+  useEffect(() => {
+    if (selected && !onOpenGame) exampleRef.current?.scrollIntoView?.({ block: 'nearest', behavior: 'smooth' });
+  }, [selected?.key, selected?.side]);
+
+  if (!view) return null; // not this viewer's to see — presentation.js decides
+
+  const open = (line, entry = null) => {
+    const target = entry ? { gameId: entry.gameId, ply: entry.ply } : line.example;
+    if (!target) return;
+    setSelected({ side: line.side, key: line.key, gameId: target.gameId, ply: target.ply });
+    onOpenGame?.(target.gameId, target.ply, line.side);
+  };
+
+  const isActive = (line) => selected?.side === line.side && selected?.key === line.key;
+  const movesPerSide = plies / 2;
+
+  if (view.totalGames === 0) {
+    return (
+      <div className="repertoire">
+        <p className="rep-empty">
+          {audience === 'coach'
+            ? 'No finished games with a recorded opening for this player yet.'
+            : 'No games with a recorded opening yet. Once you have played a few, the openings you use will show up here.'}
+        </p>
+      </div>
+    );
+  }
+
+  return (
+    <div className="repertoire">
+      <div className="rep-toolbar" role="group" aria-label="How finely to split the lines">
+        <span className="rep-toolbar-label">Group by the first</span>
+        {GROUPING_PLIES.map((option) => (
+          <button
+            key={option}
+            type="button"
+            className={`rep-chip ${option === plies ? 'active' : ''}`}
+            aria-pressed={option === plies}
+            onClick={() => setPlies(option)}
+          >
+            {option / 2} moves
+          </button>
+        ))}
+      </div>
+
+      <Highlights view={view} audience={audience} onPick={open} />
+
+      <div className="rep-sides">
+        {['w', 'b'].map((side) => (
+          <SideBlock
+            key={side}
+            block={view.sides[side]}
+            audience={audience}
+            movesPerSide={movesPerSide}
+            canGroupCoarser={plies > GROUPING_PLIES[0]}
+            isActive={isActive}
+            onPick={open}
+          />
+        ))}
+      </div>
+
+      {selectedLine && (
+        <div className="rep-example" ref={exampleRef}>
+          <ExampleBlock
+            line={selectedLine}
+            selected={selected}
+            audience={audience}
+            onPick={(entry) => open(selectedLine, entry)}
+            onClose={() => setSelected(null)}
+            embedded={!onOpenGame}
+          />
+          {!onOpenGame && (
+            <EmbeddedReview
+              gameId={selected.gameId}
+              ply={selected.ply}
+              side={selectedLine.side}
+              games={games}
+              analyses={analyses}
+              viewer={viewer}
+            />
+          )}
+        </div>
+      )}
+
+      <p className="rep-footnote">
+        A line is the first {movesPerSide} moves exactly as played in finished games. It is listed
+        once it has come up in {DEFAULT_MIN_GAMES} games; results show from {MIN_RESULT_GAMES} games,
+        and opening accuracy and mistake patterns from {MIN_ANALYSED_GAMES} analysed games. Opening
+        accuracy covers moves {OPENING_ACCURACY_FROM_MOVE}&ndash;{OPENING_ACCURACY_TO_MOVE}: until the
+        app has an opening book, the first {OPENING_ACCURACY_FROM_MOVE - 1} moves each are treated as
+        book and not graded.
+      </p>
+    </div>
+  );
+}
+
+/** The top of the panel: what is working, and what to look at. */
+function Highlights({ view, audience, onPick }) {
+  const { strongest, weakest } = view;
+  const toWorkOn = audience === 'coach' ? weakest.slice(0, COACH_WEAK_LIMIT) : weakest.slice(0, 1);
+  if (!strongest && !toWorkOn.length) return null;
+
+  return (
+    <div className="rep-highlights">
+      {strongest && (
+        <button type="button" className="rep-highlight good" onClick={() => onPick(strongest)}>
+          <span className="rep-highlight-title">
+            {audience === 'coach' ? 'Best-scoring line' : 'Going well'}
+          </span>
+          <span className="rep-line-key mono">{strongest.key}</span>
+          <span className="rep-highlight-text">
+            As {sideLabel(strongest.side)}: {scoreText(strongest)}
+            {audience === 'coach' ? '.' : '. Keep playing it.'}
+          </span>
+        </button>
+      )}
+      {toWorkOn.map((line) => (
+        <button
+          key={`${line.side}:${line.key}`}
+          type="button"
+          className="rep-highlight focus"
+          onClick={() => onPick(line)}
+        >
+          <span className="rep-highlight-title">
+            {audience === 'coach' ? 'Scoring below half' : 'Worth a look'}
+          </span>
+          <span className="rep-line-key mono">{line.key}</span>
+          <span className="rep-highlight-text">
+            As {sideLabel(line.side)}: {scoreText(line)}
+            {audience === 'coach' ? '.' : ' so far.'} {slipText(line, audience) ?? ''}
+          </span>
+        </button>
+      ))}
+    </div>
+  );
+}
+
+function SideBlock({ block, audience, movesPerSide, canGroupCoarser, isActive, onPick }) {
+  const label = sideLabel(block.side);
+  const accuracy =
+    block.openingAccuracy != null
+      ? `opening accuracy ${block.openingAccuracy}% (${plural(block.analysedGames, 'analysed game')})`
+      : `opening accuracy: ${NOT_ENOUGH}`;
+
+  return (
+    <section className="rep-side" aria-label={`As ${label}`}>
+      <h4 className="rep-side-title">As {label}</h4>
+      <p className="rep-side-summary">
+        {plural(block.games, 'game')}
+        {block.games > 0 && (
+          <>
+            {' · '}
+            {block.scored ? recordText(block) : NOT_ENOUGH}
+            {' · '}
+            {accuracy}
+          </>
+        )}
+      </p>
+
+      {block.lines.length ? (
+        <ul className="rep-lines">
+          {block.lines.map((line) => (
+            <li key={line.key}>
+              <LineButton
+                line={line}
+                colourGames={block.games}
+                audience={audience}
+                active={isActive(line)}
+                onPick={onPick}
+              />
+            </li>
+          ))}
+        </ul>
+      ) : (
+        <p className="rep-empty">
+          {block.games === 0
+            ? `No finished games as ${label} yet.`
+            : `${capitalise(NOT_ENOUGH)}: none of these games share the same first ${movesPerSide} moves.${
+                canGroupCoarser ? ' Try grouping by fewer moves.' : ''
+              }`}
+        </p>
+      )}
+
+      {block.lines.length > 0 && block.oneOffGames > 0 && (
+        <p className="rep-hint">
+          {plural(block.oneOffGames, 'other game')} as {label} went{' '}
+          {block.oneOffGames === 1 ? 'its' : 'their'} own way in the first {movesPerSide} moves.
+          {canGroupCoarser ? ' Group by fewer moves to include them.' : ''}
+        </p>
+      )}
+    </section>
+  );
+}
+
+function LineButton({ line, colourGames, audience, active, onPick }) {
+  const note = slipText(line, audience);
+  return (
+    <button
+      type="button"
+      className={`rep-line ${active ? 'active' : ''}`}
+      aria-pressed={active}
+      onClick={() => onPick(line)}
+    >
+      <span className="rep-line-key mono">{line.key}</span>
+      <span className="rep-line-stats">
+        <span>
+          {line.games} of {plural(colourGames, 'game')}
+        </span>
+        <span className={line.scored ? '' : 'rep-thin'}>{scoreText(line)}</span>
+        {line.scored && line.openingAccuracy != null && (
+          <span>opening accuracy {accuracyText(line)}</span>
+        )}
+      </span>
+      {line.scored && (
+        <span className="rep-bar" role="img" aria-label={recordText(line)} title={recordText(line)}>
+          <span className="rep-bar-won" style={{ flexGrow: line.wins }} />
+          <span className="rep-bar-drew" style={{ flexGrow: line.draws }} />
+          <span className="rep-bar-lost" style={{ flexGrow: line.losses }} />
+        </span>
+      )}
+      {note && <span className="rep-line-note">{note}</span>}
+    </button>
+  );
+}
+
+/** The selected line's games, each one click from the board. */
+function ExampleBlock({ line, selected, audience, onPick, onClose, embedded }) {
+  const current = line.entries.find((e) => e.gameId === selected.gameId) || null;
+  let why = null;
+  if (current?.reason === 'slip') {
+    why =
+      audience === 'coach'
+        ? `Opens at move ${current.slipMove}: the first opening mistake in this game.`
+        : `Opens at move ${current.slipMove}, where this game first went wrong. See what the engine preferred.`;
+  } else if (current) {
+    why = `Opens after move ${Math.ceil(current.ply / 2)}, where the line's name ends.`;
+  }
+
+  return (
+    <>
+      <div className="rep-example-head">
+        <h4 className="rep-side-title">
+          As {sideLabel(line.side)}: <span className="mono rep-example-key">{line.key}</span>
+        </h4>
+        <button type="button" className="link-button" onClick={onClose}>
+          Close
+        </button>
+      </div>
+      {why && (
+        <p className="rep-example-why">
+          {why}
+          {!embedded && ' The game is open in the viewer below.'}
+        </p>
+      )}
+      <div className="rep-games" aria-label="Games in this line">
+        {line.entries.map((entry) => (
+          <button
+            key={entry.gameId}
+            type="button"
+            className={`rep-game ${entry.gameId === selected.gameId ? 'active' : ''}`}
+            aria-pressed={entry.gameId === selected.gameId}
+            onClick={() => onPick(entry)}
+          >
+            <span className="mono">{String(entry.playedAt ?? '').slice(0, 10) || '—'}</span>
+            {entry.opponent ? ` vs ${entry.opponent}` : ''} · {OUTCOME_LABEL[entry.outcome]}
+            {entry.mode && entry.mode !== 'human' && GAME_MODE_LABEL[entry.mode]
+              ? ` · ${GAME_MODE_LABEL[entry.mode]}`
+              : ''}
+            {entry.reason === 'slip' ? ` · move ${entry.slipMove}` : ''}
+          </button>
+        ))}
+      </div>
+    </>
+  );
+}
+
+/** The Roster's own board for the example game, oriented to the player's side. */
+function EmbeddedReview({ gameId, ply, side, games, analyses, viewer }) {
+  const game = games.find((g) => g.id === gameId) || null;
+  // Same rule as GameAnalysisPanel: only the sides this viewer may see.
+  const visible = useMemo(
+    () =>
+      (analyses || []).filter(
+        (row) =>
+          row.gameId === gameId &&
+          canViewAnalysis(
+            viewer,
+            row.playerId ?? (row.side === 'w' ? game?.whitePlayerId : game?.blackPlayerId),
+          ),
+      ),
+    [analyses, gameId, viewer?.role, viewer?.playerId, game],
+  );
+  if (!game) return null;
+  return (
+    <GameReview
+      key={`${game.id}:${ply}`}
+      game={game}
+      analyses={visible}
+      orientation={side}
+      initialPly={ply}
+    />
+  );
+}
