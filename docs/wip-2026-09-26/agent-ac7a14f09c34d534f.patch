index 0000000..7f361e6
--- /dev/null
+++ b/src/analysis/repertoireView.js
@@ -0,0 +1,376 @@
+/*
+ * repertoireView.js — what the repertoire UI shows, built around repertoire.js.
+ *
+ * repertoire.js answers "which lines does this player reach, and how do they
+ * score?" from plain { whitePlayerId, blackPlayerId, result, sanMoves } rows.
+ * The UI needs three things it deliberately does not know about:
+ *
+ *   1. The archive stores PGN, not sanMoves. Something has to turn one into
+ *      the other, and refuse the games that have no opening to name.
+ *   2. Which games make up each line, so an entry can open one of them.
+ *   3. How the engine judged the player's own opening moves, and where in
+ *      those games things first went wrong.
+ *
+ * This module adds exactly that and leaves repertoire.js as it is: the line
+ * keys, the counts and the scoring all still come from there.
+ *
+ * Pure and React-free, like the rest of src/analysis, so the rules that matter
+ * most here — only this player's games, only their side of the analysis, and
+ * no verdict from one or two games — are asserted in repertoireView.test.js.
+ */
+
+import { Chess, START_FEN } from '../engine/chess.js';
+import { parsePgn, playSan } from './pgn.js';
+import { classifyPly } from './scoring.js';
+import { BOOK_PLIES_FALLBACK, OPENING_LAST_FULLMOVE } from './buildPlyRecords.js';
+import { canViewAnalysis, NOT_ENOUGH } from './presentation.js';
+import {
+  DEFAULT_MIN_GAMES,
+  DEFAULT_PLIES,
+  DEFAULT_WEAKEST_MIN_GAMES,
+  openingKey,
+  playerScore,
+  repertoireReport,
+  weakestLines,
+} from './repertoire.js';
+
+/*
+ * How finely the UI may split lines: two, three or four moves a side. Eight is
+ * repertoire.js's own default. At club level most games leave any given line
+ * within four moves, so the coarser settings are what make a beginner's
+ * repertoire visible at all.
+ */
+export const GROUPING_PLIES = Object.freeze([4, 6, 8]);
+
+/*
+ * A line is LISTED from two games (repertoire.js's floor: "an accident, not a
+ * repertoire"), but its results are only SHOWN from three — the same bar
+ * weakestLines uses before it points at a problem. "Lost both" is two games,
+ * not a habit, and presentation.js is explicit that thin evidence is worded as
+ * "not enough games yet", never shown as a number.
+ */
+export const MIN_RESULT_GAMES = DEFAULT_WEAKEST_MIN_GAMES;
+
+/** Analysed games needed before an opening accuracy or a "first mistake" pattern is shown. */
+export const MIN_ANALYSED_GAMES = 3;
+
+/** The labels that count as "going wrong". Inaccuracies are too common to be a pattern. */
+const SERIOUS_LABELS = new Set(['mistake', 'blunder']);
+
+/*
+ * The moves the engine calls "opening" but does not grade as book: without an
+ * opening book the analyser treats the first BOOK_PLIES_FALLBACK plies as
+ * book (buildPlyRecords.js), and the opening phase ends at move 12. The spec
+ * says the UI must say so rather than imply real book knowledge.
+ */
+export const OPENING_ACCURACY_FROM_MOVE = Math.floor(BOOK_PLIES_FALLBACK / 2) + 1;
+export const OPENING_ACCURACY_TO_MOVE = OPENING_LAST_FULLMOVE;
+
+/** The four placement/turn/castling/ep fields: a FEN tag of the normal start is still a normal game. */
+const boardFields = (fen) => String(fen).trim().split(/\s+/).slice(0, 4).join(' ');
+
+/**
+ * The first `maxPlies` mainline moves of a PGN, in the engine's own SAN.
+ *
+ * Replaying rather than trusting the text is what makes two games of the same
+ * line share a key: "Nf3" and "Ng1f3", or "Bb5" and "Bb5+", are one move.
+ *
+ * @returns {string[]} [] for anything that names no opening: unparseable text,
+ *   a game set up from a position, a variant, or a move that will not replay.
+ */
+export function openingMoves(pgn, maxPlies = DEFAULT_PLIES) {
+  if (typeof pgn !== 'string' || !pgn.trim()) return [];
+
+  let parsed;
+  try {
+    [parsed] = parsePgn(pgn);
+  } catch {
+    return [];
+  }
+  if (!parsed || parsed.invalid) return [];
+
+  const tags = parsed.tags || {};
+  // A game started from a position has no opening, and a Chess960 "1.e4" is
+  // not the move a club player's repertoire is made of.
+  if (typeof tags.FEN === 'string' && tags.FEN.trim() && boardFields(tags.FEN) !== boardFields(START_FEN)) {
+    return [];
+  }
+  if (typeof tags.Variant === 'string' && tags.Variant.trim() && !/^standard$/i.test(tags.Variant.trim())) {
+    return [];
+  }
+
+  const limit = Number.isFinite(maxPlies) ? Math.max(0, Math.floor(maxPlies)) : DEFAULT_PLIES;
+  const board = new Chess(START_FEN);
+  const sans = [];
+  for (const move of parsed.moves.slice(0, limit)) {
+    let played = null;
+    try {
+      played = playSan(board, move.san);
+    } catch {
+      played = null;
+    }
+    // A broken move inside the opening would give the game a truncated key of
+    // its own — a fake line. Better to leave the game out.
+    if (!played) return [];
+    sans.push(played.san);
+  }
+  return sans;
+}
+
+/** 'w' | 'b' | null. An empty player id matches nothing: gamesStore uses '' for "no player". */
+function sideOf(game, playerId) {
+  if (!game || playerId == null || playerId === '') return null;
+  if (game.whitePlayerId === playerId) return 'w';
+  if (game.blackPlayerId === playerId) return 'b';
+  return null;
+}
+
+/**
+ * This player's games, and only theirs, with the fields repertoire.js reads.
+ * Newest first, so "the most recent example" is simply the first one.
+ */
+export function playerGames(games, playerId, { plies = DEFAULT_PLIES } = {}) {
+  const out = [];
+  for (const game of Array.isArray(games) ? games : []) {
+    const side = sideOf(game, playerId);
+    if (!side) continue; // someone else's game never reaches the report
+    const sanMoves = openingMoves(game.pgn, plies);
+    if (!sanMoves.length) continue;
+    out.push({
+      ...game,
+      side,
+      sanMoves,
+      key: openingKey(sanMoves, plies),
+      points: playerScore(game.result, side),
+    });
+  }
+  return out.sort(
+    (a, b) => String(b.playedAt ?? '').localeCompare(String(a.playedAt ?? '')) || String(a.id).localeCompare(String(b.id)),
+  );
+}
+
+/**
+ * The player's opening moves in one analysed game, as the engine judged them.
+ *
+ * Only plies of `side` are read, whatever else the row carries: the other side
+ * of the board is somebody else's analysis.
+ *
+ * @returns {{accuracies: number[], slip: object|null}|null} null when the row
+ *   has no per-move detail to read.
+ */
+export function openingPlay(row, side) {
+  if (!row || !Array.isArray(row.plies)) return null;
+  const accuracies = [];
+  let slip = null;
+  const plies = row.plies.filter((p) => p && p.side === side && p.phase === 'opening');
+  plies.sort((a, b) => a.ply - b.ply);
+  for (const ply of plies) {
+    const judged = classifyPly(ply);
+    // `counted` is scoring.js's own filter: book moves and decided positions
+    // are not graded, so they are neither accuracy nor a mistake.
+    if (!judged.counted) continue;
+    accuracies.push(judged.accuracy);
+    if (!slip && SERIOUS_LABELS.has(judged.label)) {
+      slip = { ply: ply.ply, fullmove: ply.fullmove, san: ply.san, label: judged.label };
+    }
+  }
+  return { accuracies, slip };
+}
+
+const mean = (xs) => (xs.length ? xs.reduce((a, b) => a + b, 0) / xs.length : null);
+
+/** The lower median: "around move 9" should be a move that actually happened. */
+function median(xs) {
+  if (!xs.length) return null;
+  const sorted = [...xs].sort((a, b) => a - b);
+  return sorted[Math.floor((sorted.length - 1) / 2)];
+}
+
+const outcomeOf = (points) => (points === 1 ? 'won' : points === 0.5 ? 'drew' : 'lost');
+
+/** Accuracy and first-mistake figures for a set of games, withheld when thin. */
+function openingFigures(entries) {
+  const analysed = entries.filter((e) => e.play && e.play.accuracies.length);
+  const enough = analysed.length >= MIN_ANALYSED_GAMES;
+  const slips = analysed.filter((e) => e.play.slip);
+  return {
+    analysedGames: analysed.length,
+    openingAccuracy: enough ? Math.round(mean(analysed.flatMap((e) => e.play.accuracies))) : null,
+    slip: enough
+      ? {
+          games: slips.length,
+          typicalMove: median(slips.map((e) => e.play.slip.fullmove)),
+        }
+      : null,
+  };
+}
+
+/**
+ * Everything the repertoire panel renders for one player.
+ *
+ * Returns null when `viewer` may not see this player's analysis — the same
+ * rule, from presentation.js, as every other analysis view. The repertoire is
+ * built from the engine's verdicts and says which lines are losing, which is
+ * exactly what "no player ever sees another player's analysis" protects.
+ *
+ * @param {{viewer: object, games: object[], analyses: object[], playerId: string, plies?: number}} input
+ */
+export function buildRepertoireView({ viewer, games, analyses, playerId, plies = DEFAULT_PLIES }) {
+  if (!canViewAnalysis(viewer, playerId)) return null;
+
+  const mine = playerGames(games, playerId, { plies });
+
+  // Only the rows for this player's side of this player's games.
+  const wanted = new Set(mine.map((g) => `${g.id}:${g.side}`));
+  const rows = new Map();
+  for (const row of Array.isArray(analyses) ? analyses : []) {
+    const key = `${row?.gameId}:${row?.side}`;
+    if (wanted.has(key)) rows.set(key, row);
+  }
+
+  const entryFor = (game) => {
+    const play = openingPlay(rows.get(`${game.id}:${game.side}`), game.side);
+    return {
+      gameId: game.id,
+      playedAt: game.playedAt ?? null,
+      opponent: (game.side === 'w' ? game.blackName : game.whiteName) || '',
+      mode: game.mode ?? null,
+      outcome: outcomeOf(game.points),
+      // Open at the first real mistake if the engine found one; otherwise at
+      // the position the line's name describes.
+      ply: play?.slip ? play.slip.ply : game.sanMoves.length,
+      reason: play?.slip ? 'slip' : 'line',
+      slipMove: play?.slip?.fullmove ?? null,
+      play,
+    };
+  };
+
+  // Undecided games are left out, exactly as repertoireReport leaves them out,
+  // so a line's list of games always matches its count.
+  const decided = mine.filter((g) => g.points !== null);
+  const report = repertoireReport(decided, playerId, { plies, minGames: DEFAULT_MIN_GAMES });
+
+  const bySide = {};
+  for (const side of ['w', 'b']) {
+    const sideGames = decided.filter((g) => g.side === side);
+    const entries = sideGames.map(entryFor);
+    const byKey = new Map();
+    sideGames.forEach((game, i) => {
+      if (!byKey.has(game.key)) byKey.set(game.key, []);
+      byKey.get(game.key).push(entries[i]);
+    });
+
+    const lines = (side === 'w' ? report.asWhite : report.asBlack).map((line) => {
+      const lineEntries = byKey.get(line.key) || [];
+      const example = lineEntries.find((e) => e.reason === 'slip') || lineEntries[0] || null;
+      return {
+        ...line,
+        side,
+        scored: line.games >= MIN_RESULT_GAMES,
+        entries: lineEntries.map(stripPlay),
+        example: example ? { gameId: example.gameId, ply: example.ply, reason: example.reason } : null,
+        ...openingFigures(lineEntries),
+      };
+    });
+
+    const wins = sideGames.filter((g) => g.points === 1).length;
+    const draws = sideGames.filter((g) => g.points === 0.5).length;
+    bySide[side] = {
+      side,
+      games: sideGames.length,
+      wins,
+      draws,
+      losses: sideGames.length - wins - draws,
+      score: sideGames.length ? (wins + draws * 0.5) / sideGames.length : null,
+      scored: sideGames.length >= MIN_RESULT_GAMES,
+      lines,
+      // Games that fall in no listed line: one-offs at this grouping.
+      oneOffGames: sideGames.length - lines.reduce((n, l) => n + l.games, 0),
+      ...openingFigures(entries),
+    };
+  }
+
+  // Worst first across both colours, but only real problems: a line scoring
+  // half or better is not something to "work on".
+  const weakest = weakestLines(
+    { asWhite: bySide.w.lines, asBlack: bySide.b.lines },
+    { minGames: MIN_RESULT_GAMES },
+  ).filter((line) => line.score < 0.5);
+
+  const strongest =
+    [...bySide.w.lines, ...bySide.b.lines]
+      .filter((line) => line.scored && line.score > 0.5)
+      .sort((a, b) => b.score - a.score || b.games - a.games || a.key.localeCompare(b.key))[0] ?? null;
+
+  return {
+    playerId,
+    plies,
+    totalGames: mine.length,
+    unfinishedGames: mine.length - decided.length,
+    sides: bySide,
+    weakest,
+    strongest,
+  };
+}
+
+/** The per-game engine detail stays internal; the UI needs only the summary. */
+function stripPlay({ play, ...entry }) {
+  return entry;
+}
+
+/* ── wording ──────────────────────────────────────────────────────────────
+ *
+ * Kept here, beside the thresholds, so the rule "no verdict from one or two
+ * games" is enforced by a test rather than by whoever writes the JSX next.
+ */
+
+/** "3½" — points the way a chess player writes them. */
+export function pointsText(wins, draws) {
+  const points = wins + draws * 0.5;
+  const whole = Math.floor(points);
+  const half = points - whole >= 0.5;
+  if (!half) return String(whole);
+  return whole === 0 ? '½' : `${whole}½`;
+}
+
+const plural = (n, one, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;
+
+/** "3½ out of 5", or NOT_ENOUGH below MIN_RESULT_GAMES. */
+export function scoreText(line) {
+  if (!line || !line.scored) return NOT_ENOUGH;
+  return `${pointsText(line.wins, line.draws)} out of ${line.games}`;
+}
+
+/** "3 won, 1 drawn, 1 lost", or NOT_ENOUGH below MIN_RESULT_GAMES. */
+export function recordText(line) {
+  if (!line || !line.scored) return NOT_ENOUGH;
+  return `${line.wins} won, ${line.draws} drawn, ${line.losses} lost`;
+}
+
+/** "81%", or NOT_ENOUGH below MIN_ANALYSED_GAMES analysed games. */
+export function accuracyText(line) {
+  if (!line || line.openingAccuracy == null) return NOT_ENOUGH;
+  return `${line.openingAccuracy}%`;
+}
+
+/**
+ * Where it tends to go wrong, in words. Null when there is nothing honest to
+ * say yet. The player's version is written to them and points at the example;
+ * the coach's is the plain count.
+ */
+export function slipText(line, audience = 'player') {
+  if (!line || !line.slip) return null;
+  const { games, typicalMove } = line.slip;
+  const n = line.analysedGames;
+  if (games === 0) {
+    return audience === 'coach'
+      ? `No opening mistakes in ${plural(n, 'analysed game')}.`
+      : `No real mistakes in the opening across ${plural(n, 'analysed game')}. Nicely played.`;
+  }
+  return audience === 'coach'
+    ? `First opening mistake in ${games} of ${plural(n, 'analysed game')}, typically move ${typicalMove}.`
+    : `In ${games} of your ${plural(n, 'analysed game')} here, the first real mistake came around move ${typicalMove}. The example opens right there.`;
+}
+
+/** "White" / "Black". */
+export const sideLabel = (side) => (side === 'w' ? 'White' : 'Black');
