+
+test('openingPlay ignores the other side of the board and inaccuracies', () => {
+  const blackBlunders = openingPlies('b', { slipAtPly: 12, blunder: true });
+  assert.equal(openingPlay({ plies: blackBlunders }, 'w').accuracies.length, 0, 'no White plies');
+  const inaccuracy = [ply(9, 'w', { best: false, cpAfter: -20 })]; // ~5.5 win% lost
+  assert.equal(openingPlay({ plies: inaccuracy }, 'w').slip, null, 'an inaccuracy is not "going wrong"');
