@@ -0,0 +1,396 @@
+/*
+ * The repertoire panel's rules: only this player's games, only their side of
+ * the analysis, and no verdict from one or two games. The UI is thin on
+ * purpose; everything it is not allowed to get wrong is asserted here.
+ */
+
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+import {
+  openingMoves,
+  playerGames,
+  openingPlay,
+  buildRepertoireView,
+  pointsText,
+  scoreText,
+  recordText,
+  accuracyText,
+  slipText,
+  MIN_RESULT_GAMES,
+  MIN_ANALYSED_GAMES,
+  OPENING_ACCURACY_FROM_MOVE,
+  OPENING_ACCURACY_TO_MOVE,
+} from './repertoireView.js';
+import { openingKey } from './repertoire.js';
+import { NOT_ENOUGH } from './presentation.js';
+
+const ITALIAN = ['e4', 'e5', 'Nf3', 'Nc6', 'Bc4', 'Bc5', 'c3', 'Nf6', 'd3', 'd6'];
+const RUY = ['e4', 'e5', 'Nf3', 'Nc6', 'Bb5', 'a6', 'Ba4', 'Nf6', 'O-O', 'Be7'];
+const SICILIAN = ['e4', 'c5', 'Nf3', 'd6', 'd4', 'cxd4', 'Nxd4', 'Nf6', 'Nc3', 'a6'];
+const LONDON = ['d4', 'd5', 'Bf4', 'Nf6', 'e3', 'e6', 'Nf3', 'Bd6', 'Bg3', 'O-O'];
+
+const coach = { role: 'coach', playerId: 'P-COACH' };
+const admin = { role: 'admin', playerId: null };
+const alice = { role: 'player', playerId: 'P1' };
+const bob = { role: 'player', playerId: 'P2' };
+
+/** Real PGN text, the way the archive stores it. */
+function pgnOf(sans, { result = '*', tags = {} } = {}) {
+  const header = Object.entries({ Event: 'Club', White: 'W', Black: 'B', Result: result, ...tags })
+    .map(([k, v]) => `[${k} "${v}"]`)
+    .join('\n');
+  const body = [];
+  sans.forEach((san, i) => {
+    if (i % 2 === 0) body.push(`${i / 2 + 1}.`);
+    body.push(san);
+  });
+  return `${header}\n\n${body.join(' ')} ${result}\n`;
+}
+
+let seq = 0;
+/** An archive row as gamesStore holds it. */
+function game(white, black, result, sans, extra = {}) {
+  seq += 1;
+  return {
+    id: `G-${seq}`,
+    playedAt: `2026-09-${String(seq % 28 + 1).padStart(2, '0')}T18:00:00Z`,
+    whitePlayerId: white,
+    blackPlayerId: black,
+    whiteName: white === 'P1' ? 'Alice' : `Opp ${white}`,
+    blackName: black === 'P1' ? 'Alice' : `Opp ${black}`,
+    result,
+    mode: 'human',
+    pgn: pgnOf(sans, { result }),
+    ...extra,
+  };
+}
+
+/** One ply record the way buildPlyRecords stores it on game_analyses.plies. */
+function ply(n, side, { cpBefore = 30, cpAfter = 30, best = true, phase = 'opening', inBook = false } = {}) {
+  return {
+    ply: n,
+    fullmove: Math.ceil(n / 2),
+    side,
+    san: 'x',
+    uci: best ? 'a2a3' : 'h2h3',
+    bestUci: 'a2a3',
+    cpBefore,
+    mateBefore: null,
+    cpAfter,
+    mateAfter: null,
+    secondBestDelta: 0,
+    inBook,
+    phase,
+  };
+}
+
+/** Plies 9..20 for `side` (moves 5..10), all accurate unless a slip is placed. */
+function openingPlies(side, { slipAtPly = null, blunder = false } = {}) {
+  const out = [];
+  for (let n = 1; n <= 20; n += 1) {
+    const mover = n % 2 === 1 ? 'w' : 'b';
+    if (mover !== side) continue;
+    if (n <= 8) {
+      out.push(ply(n, side, { inBook: true }));
+    } else if (n === slipAtPly) {
+      out.push(ply(n, side, { best: false, cpAfter: blunder ? -300 : -120 }));
+    } else {
+      out.push(ply(n, side));
+    }
+  }
+  return out;
+}
+
+const analysisRow = (g, side, plies) => ({ gameId: g.id, side, playerId: side === 'w' ? g.whitePlayerId : g.blackPlayerId, plies });
+
+/* ── openingMoves ─────────────────────────────────────────────────────────── */
+
+test('openingMoves reads the mainline in the engine’s SAN, clocks and variations ignored', () => {
+  const pgn = `[Event "Club"]\n[Result "1-0"]\n\n1. e4 {[%clk 0:09:58]} e5 (1... c5 2. Nf3) 2. Ng1f3 Nc6 3. Bb5 a6 1-0\n`;
+  assert.deepEqual(openingMoves(pgn, 8), ['e4', 'e5', 'Nf3', 'Nc6', 'Bb5', 'a6']);
+  assert.deepEqual(openingMoves(pgn, 3), ['e4', 'e5', 'Nf3'], 'truncated by ply');
+});
+
+test('openingMoves normalises castling and check marks so one move has one key', () => {
+  const withZeros = pgnOf(['e4', 'e5', 'Nf3', 'Nc6', 'Bc4', 'Nf6', '0-0', 'Be7']);
+  const withOs = pgnOf(['e4', 'e5', 'Nf3', 'Nc6', 'Bc4', 'Nf6', 'O-O', 'Be7']);
+  assert.deepEqual(openingMoves(withZeros), openingMoves(withOs));
+  assert.equal(openingMoves(withZeros)[6], 'O-O');
+  // The engine adds the check mark itself; a PGN that omits it is the same move.
+  const bare = openingMoves(pgnOf(['e4', 'e5', 'Bc4', 'Nc6', 'Qh5', 'Nf6', 'Qxf7']));
+  assert.equal(bare[6], 'Qxf7#');
+});
+
+test('openingMoves names no opening for positions, variants, junk and broken moves', () => {
+  const fromPosition = pgnOf(['Kf2'], {
+    tags: { SetUp: '1', FEN: '8/8/8/8/8/8/8/4K2k w - - 0 1' },
+  });
+  assert.deepEqual(openingMoves(fromPosition), [], 'set-up position');
+  assert.deepEqual(openingMoves(pgnOf(ITALIAN, { tags: { Variant: 'Chess960' } })), [], 'variant');
+  assert.deepEqual(openingMoves(pgnOf(['e4', 'e5', 'Ke3'])), [], 'illegal move inside the opening');
+  assert.deepEqual(openingMoves('not a pgn at all'), []);
+  assert.deepEqual(openingMoves(''), []);
+  assert.deepEqual(openingMoves(null), []);
+  assert.deepEqual(openingMoves(undefined), []);
+});
+
+test('a FEN tag holding the normal start position is still a normal game', () => {
+  const pgn = pgnOf(ITALIAN, {
