diff --git a/src/styles/repertoire.css b/src/styles/repertoire.css
new file mode 100644
index 0000000..77b4ba8
--- /dev/null
+++ b/src/styles/repertoire.css
@@ -0,0 +1,263 @@
+/* =========================================================================
+   Repertoire panel (RepertoirePanel.jsx), on My games and the Roster detail.
+   Its own file so app.css stays one person's stylesheet; everything is
+   scoped under .repertoire and uses app.css's tokens, so both themes work.
+   ========================================================================= */
+
+.repertoire {
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  margin-top: 10px;
+  min-width: 0;
+}
+
+/* Grouping control: a small segmented choice, not a form. */
+.rep-toolbar {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 6px;
+}
+
+.rep-toolbar-label {
+  font-size: 0.8rem;
+  color: var(--text-muted);
+  margin-right: 2px;
+}
+
+.rep-chip,
+.rep-game {
+  font-size: 0.8rem;
+  color: var(--text-muted);
+  background: var(--bg-sunken);
+  border: 1px solid var(--border);
+  border-radius: 999px;
+  padding: 3px 11px;
+  cursor: pointer;
+  transition: border-color 0.12s, background 0.12s, color 0.12s;
+}
+
+.rep-chip:hover,
+.rep-game:hover {
+  border-color: var(--border-strong);
+  color: var(--text);
+}
+
+.rep-chip.active,
+.rep-game.active {
+  color: var(--text);
+  background: var(--accent-soft);
+  border-color: var(--accent);
+}
+
+/* Highlights: one "going well", and one (player) or a few (coach) to look at. */
+.rep-highlights {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
+  gap: 10px;
+}
+
+.rep-highlight {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  text-align: left;
+  color: var(--text);
+  background: var(--bg-sunken);
+  border: 1px solid var(--border);
+  border-left: 3px solid var(--border-strong);
+  border-radius: var(--radius);
+  padding: 10px 12px;
+  cursor: pointer;
+  font-size: 0.86rem;
+  min-width: 0;
+}
+
+.rep-highlight:hover {
+  border-color: var(--border-strong);
+}
+
+.rep-highlight.good {
+  border-left-color: var(--good);
+}
+
+/* The accent, not red: "worth a look" is an invitation, not an alarm. */
+.rep-highlight.focus {
+  border-left-color: var(--accent);
+}
+
+.rep-highlight-title {
+  font-size: 0.72rem;
+  text-transform: uppercase;
+  letter-spacing: 0.06em;
+  color: var(--text-faint);
+}
+
+.rep-highlight-text {
+  color: var(--text-muted);
+}
+
+/* The two colours: side by side where there is room, stacked otherwise. */
+.rep-sides {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
+  gap: 16px;
+}
+
+.rep-side {
+  min-width: 0;
+}
+
+.rep-side-title {
+  margin: 0;
+  font-size: 0.82rem;
+  text-transform: uppercase;
+  letter-spacing: 0.07em;
+  color: var(--text-muted);
+}
+
+.rep-side-summary {
+  margin: 4px 0 8px;
+  font-size: 0.84rem;
+  color: var(--text-muted);
+}
+
+.rep-lines {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.rep-line {
+  width: 100%;
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+  text-align: left;
+  color: var(--text);
+  background: var(--bg-raised);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  padding: 9px 11px;
+  cursor: pointer;
+  font-size: 0.84rem;
+  transition: border-color 0.12s, background 0.12s;
+}
+
+.rep-line:hover {
+  border-color: var(--border-strong);
+  background: var(--bg-sunken);
+}
+
+.rep-line.active {
+  border-color: var(--accent);
+  background: var(--accent-soft);
+}
+
+.rep-line-key {
+  font-size: 0.86rem;
+  color: var(--text);
+  overflow-wrap: anywhere;
+}
+
+.rep-line-stats {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 2px 14px;
+  color: var(--text-muted);
+}
+
+.rep-thin {
+  font-style: italic;
+  color: var(--text-faint);
+}
+
+.rep-line-note {
+  color: var(--text-muted);
+  font-size: 0.8rem;
+}
+
+/* Won / drawn / lost, proportional. The text beside it says the same thing. */
+.rep-bar {
+  display: flex;
+  height: 5px;
+  border-radius: 999px;
+  overflow: hidden;
+  background: var(--bg-sunken);
+}
+
+.rep-bar-won {
+  background: var(--good);
+}
+
+.rep-bar-drew {
+  background: var(--text-faint);
+}
+
+.rep-bar-lost {
+  background: var(--bad);
+  opacity: 0.8;
+}
+
+.rep-empty,
+.rep-hint,
+.rep-footnote,
+.rep-example-why {
+  margin: 0;
+  font-size: 0.82rem;
+  color: var(--text-muted);
+}
+
+.rep-hint {
+  margin-top: 8px;
+}
+
+.rep-footnote {
+  font-size: 0.76rem;
+  color: var(--text-faint);
+}
+
+/* The selected line's games and, on the Roster, the board. */
+.rep-example {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  border-top: 1px solid var(--border);
+  padding-top: 12px;
+  min-width: 0;
+}
+
+.rep-example-head {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 10px;
+}
+
+.rep-example-key {
+  text-transform: none;
+  letter-spacing: 0;
+  color: var(--text);
+  overflow-wrap: anywhere;
+}
+
+.rep-games {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+
+/* Inside the Roster's narrow detail column the review stacks: a 260px board
+   beside a move list helps nobody. */
+.repertoire .game-review {
+  grid-template-columns: minmax(0, 1fr);
+}
+
+/* My games: the panel sits between two others that have no spacing of their own. */
+.repertoire-panel {
+  margin: 20px 0;
+}
