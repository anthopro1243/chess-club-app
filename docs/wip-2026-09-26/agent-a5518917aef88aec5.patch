@@ -0,0 +1,260 @@
+import { useEffect, useMemo, useState } from 'react';
+import { createPortal } from 'react-dom';
+import { PUZZLES } from '../data/puzzles.js';
+import { useClubSessions, saveSessionPlan } from '../data/clubSessionsStore.js';
+import {
+  cancelledDates,
+  clubDate,
+  formatSessionDate,
+  latestPlanBefore,
+  upcomingSessions,
+} from '../data/sessions.js';
+import { planSession, themeLabel } from '../analysis/sessionPlanner.js';
+import InfoTooltip from './InfoTooltip.jsx';
+import '../styles/sessions.css';
+
+const PLANNABLE_AHEAD = 4;
+const PRINT_CLASS = 'printing-session-plan';
+
+const minutesLabel = (item) => `${item.start}–${item.end} min`;
+
+/** One plan, rendered. Used on screen and, via a portal, for printing. */
+function PlanView({ plan }) {
+  const focuses = Array.isArray(plan?.focuses) ? plan.focuses : [];
+  const agenda = Array.isArray(plan?.agenda) ? plan.agenda : [];
+  const warmup = plan?.warmup?.puzzles ?? [];
+  return (
+    <div className="session-plan-body">
+      <h3 className="session-plan-heading">
+        Session plan · {plan?.sessionDate ? formatSessionDate(plan.sessionDate, { withYear: true }) : ''}
+      </h3>
+      {plan?.note && <p className="session-plan-note">{plan.note}</p>}
+
+      <ol className="session-agenda">
+        {agenda.map((item, i) => (
+          <li key={`${item.kind}-${i}`}>
+            <span className="session-agenda-time mono">{minutesLabel(item)}</span>
+            <span className="session-agenda-what">
+              <strong>{item.title}</strong>
+              <span>{item.detail}</span>
+            </span>
+          </li>
+        ))}
+      </ol>
+
+      <div className="session-plan-block">
+        <h4>
+          Warm-up <span className="session-plan-minutes">{plan?.warmup?.minutes ?? 10} min</span>
+        </h4>
+        <PuzzleList puzzles={warmup} />
+      </div>
+
+      {focuses.map((focus, i) => (
+        <div className="session-plan-block" key={focus.key ?? i}>
+          <h4>
+            {i + 1}. {focus.label}{' '}
+            <span className="session-plan-minutes">{focus.minutes} min</span>
+            {focus.kind === 'general' ? (
+              <span className="badge session-badge-general">general, not measured</span>
+            ) : (
+              focus.rubricAverage != null && (
+                <span className="badge">club average {Number(focus.rubricAverage).toFixed(1)} / 10</span>
+              )
+            )}
+          </h4>
+          <p className="session-plan-focus">{focus.focus}</p>
+          {Array.isArray(focus.sets) && focus.sets.length > 0 && (
+            <p className="session-plan-sets">
+              Puzzle sets:{' '}
+              {focus.sets.map((set, j) => (
+                <span key={set.theme}>
+                  {j > 0 && ' · '}
+                  <a href={set.href}>{set.label}</a>
+                </span>
+              ))}
+            </p>
+          )}
+          <PuzzleList puzzles={focus.puzzles ?? []} />
+          {focus.note && <p className="hint-text">{focus.note}</p>}
+        </div>
+      ))}
+    </div>
+  );
+}
+
+function PuzzleList({ puzzles }) {
+  if (!puzzles.length) return <p className="hint-text">No puzzles.</p>;
+  return (
+    <ol className="session-puzzles">
+      {puzzles.map((p) => (
+        <li key={p.id}>
+          <span className="mono session-puzzle-rating">{p.rating}</span>
+          <span className="session-puzzle-name">{p.name}</span>
+          <a href={p.href} className="session-puzzle-theme">
+            {themeLabel(p.theme)}
+          </a>
+          <span className="mono session-puzzle-id">#{p.id}</span>
+          {p.repeated && <span className="badge">repeat</span>}
+        </li>
+      ))}
+    </ol>
+  );
+}
+
+/**
+ * SessionPlanner — "Plan this Tuesday".
+ *
+ * Builds the lesson from the club's three weakest measured categories (the
+ * same list the Club page shows as "where group time should go"), avoiding
+ * the puzzles of the last saved plan, and lets the coach save it to that
+ * Tuesday and print it. The plan is a draft until saved: re-planning never
+ * silently replaces what was already printed and handed out.
+ */
+export default function SessionPlanner({ weakest }) {
+  const sessions = useClubSessions();
+  const cancelled = useMemo(() => cancelledDates(sessions), [sessions]);
+  const today = clubDate();
+  const upcoming = useMemo(
+    () => upcomingSessions(today, PLANNABLE_AHEAD, { skip: cancelled }),
+    [today, cancelled],
+  );
+  const [picked, setPicked] = useState(null);
+  const target = picked && upcoming.includes(picked) ? picked : upcoming[0];
+  const record = sessions.find((s) => s.sessionDate === target) ?? null;
+  const [draft, setDraft] = useState(null);
+  const [status, setStatus] = useState('');
+  const [error, setError] = useState('');
+
+  const draftPlan = draft && draft.sessionDate === target ? draft.plan : null;
+  const savedPlan = record?.plan ?? null;
+  const shown = draftPlan ?? savedPlan;
+  const isNext = target === upcoming[0];
+
+  const makePlan = () => {
+    setError('');
+    setStatus('');
+    try {
+      const plan = planSession({
+        sessionDate: target,
+        weakest,
+        puzzles: PUZZLES,
+        previousPlan: latestPlanBefore(sessions, target),
+      });
+      setDraft({ sessionDate: target, plan });
+    } catch (e) {
+      setError(`Could not build a plan: ${e.message}`);
+    }
+  };
+
+  const save = () => {
+    saveSessionPlan(target, draftPlan);
+    setDraft(null);
+    setStatus(`Saved to ${formatSessionDate(target)}.`);
+  };
+
+  // Print only the plan: the portal below is the one thing visible while the
+  // body carries PRINT_CLASS. Removed on afterprint rather than straight after
+  // print(), because not every browser blocks inside print().
+  const print = () => {
+    document.body.classList.add(PRINT_CLASS);
+    const done = () => document.body.classList.remove(PRINT_CLASS);
+    window.addEventListener('afterprint', done, { once: true });
+    window.print();
+  };
+  useEffect(() => () => document.body.classList.remove(PRINT_CLASS), []);
+
+  const weakestText = weakest.length
+    ? weakest.map((w) => w.label).join(', ')
+    : 'none measured yet';
+
+  return (
+    <section className="panel session-plan">
+      <div className="panel-header">
+        <h2>
+          Session plan
+          <InfoTooltip>
+            Built from the club&rsquo;s weakest measured categories (the Club page&rsquo;s &ldquo;where
+            group time should go&rdquo;): a short focus and 5&ndash;8 puzzles for each, spread from
+            easy to hard, plus a timed hour. Puzzles from the last saved plan are not reused. Where
+            fewer than three categories are measured the plan fills in with general tactics and says so.
+          </InfoTooltip>
+        </h2>
+        {upcoming.length > 1 && (
+          <label className="session-plan-target">
+            <select
+              aria-label="Session to plan"
+              value={target}
+              onChange={(e) => {
+                setPicked(e.target.value);
+                setStatus('');
+                setError('');
+              }}
+            >
+              {upcoming.map((date, i) => (
+                <option key={date} value={date}>
+                  {formatSessionDate(date)}
+                  {i === 0 ? ' (next)' : ''}
+                </option>
+              ))}
+            </select>
+          </label>
+        )}
+      </div>
+
+      <p className="hint-text session-plan-basis">
+        Weakest measured: {weakestText}.
+      </p>
+
+      <div className="session-plan-actions">
+        {!shown && (
+          <button type="button" className="primary" onClick={makePlan}>
+            {isNext ? 'Plan this Tuesday' : `Plan ${formatSessionDate(target)}`}
+          </button>
+        )}
+        {draftPlan && (
+          <>
+            <button type="button" className="primary" onClick={save}>
+              Save to {formatSessionDate(target)}
+            </button>
+            <button type="button" onClick={print}>
+              Print
+            </button>
+            <button type="button" onClick={() => setDraft(null)}>
+              Discard
+            </button>
+          </>
+        )}
+        {!draftPlan && savedPlan && (
+          <>
+            <span className="badge session-badge-saved">
+              Saved{savedPlan.savedAt ? ` ${String(savedPlan.savedAt).slice(0, 10)}` : ''}
+            </span>
+            <button type="button" onClick={print}>
+              Print
+            </button>
+            <button type="button" onClick={makePlan}>
+              Re-plan
+            </button>
+          </>
+        )}
+      </div>
+      {draftPlan && savedPlan && (
+        <p className="hint-text">
+          This is a new draft. The saved plan stays until you save over it.
+        </p>
+      )}
+      {draftPlan && !savedPlan && <p className="hint-text">Draft. Not saved yet.</p>}
+      {status && <p className="hint-text session-plan-status">{status}</p>}
+      {error && <p className="hint-text session-plan-error">{error}</p>}
+
+      {shown && <PlanView plan={shown} />}
+      {shown &&
+        createPortal(
+          <div className="session-plan-print" aria-hidden="true">
+            <PlanView plan={shown} />
+          </div>,
+          document.body,
+        )}
+    </section>
+  );
+}
diff --git a/src/data/clubSessionsStore.js b/src/data/clubSessionsStore.js
new file mode 100644
index 0000000..8b37221
--- /dev/null
+++ b/src/data/clubSessionsStore.js
@@ -0,0 +1,153 @@
+/*
+ * clubSessionsStore.js — what is remembered about individual Tuesdays.
+ *
+ * Sessions themselves are not stored: the club meets every Tuesday, so
+ * sessions.js derives them from the calendar and nobody has to "create" one
+ * before taking attendance. A row here exists only when a Tuesday differs
+ * from the default — the coach cancelled it (a holiday), or saved a lesson
+ * plan for it. That keeps the table sparse and means a missing row is never
+ * a missing session.
+ *
+ * Same five-part shape as gamesStore: local by default, backed by the
+ * `club_sessions` table (0021) once Supabase is configured and someone is
+ * signed in. Keyed on session_date, which is unique, so every write is an
+ * upsert and two coaches saving the same Tuesday converge on one row.
+ */
+
+import { createStore, useStore } from './store.js';
+import { supabase, isSupabaseConfigured } from './supabaseClient.js';
+import { reportSyncError } from './syncStatus.js';
+import { isIsoDate } from './sessions.js';
+
+const store = createStore('cc-club-sessions-v1', []);
+
+export function useClubSessions() {
+  return useStore(store);
+}
+
+export function getClubSessions() {
+  return store.get();
+}
+
+let cloudReady = false;
+let channel = null;
+
+function fromRow(row) {
+  return {
+    sessionDate: row.session_date,
+    cancelled: !!row.cancelled,
+    plan: row.plan ?? null,
+    notes: row.notes || '',
+    updatedAt: row.updated_at || null,
+  };
+}
+
+function toRow(session) {
+  // created_by / created_at are left to the column defaults, so an update
+  // never rewrites who first touched the row.
+  return {
+    session_date: session.sessionDate,
+    cancelled: !!session.cancelled,
+    plan: session.plan ?? null,
+    notes: session.notes || '',
+  };
+}
+
+/*
+ * PostgREST's "no such table" codes. Until 0021 is applied the pull fails
+ * with one of these; saying which migration is missing is more use to the
+ * coach than a raw relation error.
+ */
+const MISSING_TABLE = new Set(['42P01', 'PGRST205']);
+
+async function syncFromCloud() {
+  const { data, error } = await supabase
+    .from('club_sessions')
+    .select('*')
+    .order('session_date', { ascending: false })
+    .limit(500);
+  if (error) {
+    reportSyncError(
+      'the club sessions',
+      MISSING_TABLE.has(error.code)
+        ? 'the club_sessions table does not exist yet (migration 0021). Cancellations and plans stay on this device until it is applied.'
+        : error.message,
+    );
+    return;
+  }
+  cloudReady = true;
+  store.set(data.map(fromRow));
+}
+
+function subscribeRealtime() {
+  if (channel) return;
+  channel = supabase
+    .channel('club-sessions-changes')
+    .on('postgres_changes', { event: '*', schema: 'public', table: 'club_sessions' }, () => {
+      syncFromCloud();
+    })
+    .subscribe();
+}
+
+if (isSupabaseConfigured) {
+  supabase.auth.onAuthStateChange((_event, session) => {
+    if (session) {
+      syncFromCloud();
+      subscribeRealtime();
+    } else {
+      cloudReady = false;
+      if (channel) {
+        supabase.removeChannel(channel);
+        channel = null;
+      }
+    }
+  });
+  supabase.auth.getSession().then(({ data }) => {
+    if (data.session) {
+      syncFromCloud();
+      subscribeRealtime();
+    }
+  });
+}
+
+/** Merge `patch` into one Tuesday's record, creating it if need be. Returns the record. */
+function updateSession(sessionDate, patch, what) {
+  if (!isIsoDate(sessionDate)) throw new TypeError(`session date must be YYYY-MM-DD, got ${JSON.stringify(sessionDate)}`);
+  let record = null;
+  store.set((sessions) => {
+    const existing = sessions.find((s) => s.sessionDate === sessionDate);
+    record = {
+      sessionDate,
+      cancelled: false,
+      plan: null,
+      notes: '',
+      ...existing,
+      ...patch,
+      updatedAt: new Date().toISOString(),
+    };
+    return [record, ...sessions.filter((s) => s.sessionDate !== sessionDate)]
+      .sort((a, b) => b.sessionDate.localeCompare(a.sessionDate))
+      .slice(0, 500);
+  });
+
+  if (isSupabaseConfigured && cloudReady) {
+    supabase
+      .from('club_sessions')
+      .upsert(toRow(record), { onConflict: 'session_date' })
+      .then(({ error }) => {
+        if (error) reportSyncError(what, error.message);
+      });
+  }
+  return record;
+}
+
+/** Cancel a Tuesday (a holiday, a school closure) or restore it. */
+export function setSessionCancelled(sessionDate, cancelled) {
+  return updateSession(sessionDate, { cancelled: !!cancelled }, cancelled ? 'cancelling that session' : 'restoring that session');
+}
+
+/** Attach a lesson plan (sessionPlanner.js output) to a Tuesday. */
+export function saveSessionPlan(sessionDate, plan) {
+  if (!plan || typeof plan !== 'object') throw new TypeError('a session plan must be an object');
+  return updateSession(sessionDate, { plan: { ...plan, savedAt: new Date().toISOString() } }, 'that session plan');
+}
diff --git a/src/data/sessions.js b/src/data/sessions.js
new file mode 100644
index 0000000..07c5a1e
--- /dev/null
+++ b/src/data/sessions.js
@@ -0,0 +1,217 @@
+/*
+ * sessions.js — when the club meets.
+ *
+ * The club meets every Tuesday. A session is therefore not something a coach
+ * creates: it exists because the calendar says so, and the only thing ever
+ * stored about one is what makes it different (cancelled for a holiday, a
+ * saved lesson plan). This module is the calendar half of that, and it is
+ * pure so the timezone traps below can be pinned by tests.
+ *
+ * DATES ARE CALENDAR DATES, NOT INSTANTS. A session is 'YYYY-MM-DD', exactly
+ * what attendance.session_date and club_sessions.session_date hold. Two ways
+ * of getting that wrong have already bitten this codebase:
+ *
+ *   1. `new Date().toISOString().slice(0, 10)` is the date in UTC. A Tuesday
+ *      meeting in Dallas that runs past 7pm CDT is already Wednesday in UTC,
+ *      so attendance taken at the end of the session landed on Wednesday.
+ *   2. `new Date('2026-09-29')` is midnight UTC, which is Monday evening in
+ *      Chicago; formatting it with the browser's local zone prints "Mon".
+ *
+ * So: "what day is it" is asked in America/Chicago, once, at the boundary
+ * (clubDate). Everything after that is arithmetic on whole calendar days via
+ * Date.UTC, which has no zone and no DST, so adding 7 days always lands on the
+ * next Tuesday regardless of where the browser thinks it is.
+ */
+
+/** Tuesday, in Date#getUTCDay numbering (0 = Sunday). */
+export const CLUB_WEEKDAY = 2;
+/** The club's own clock: SEM at Townview, Dallas. */
+export const CLUB_TIME_ZONE = 'America/Chicago';
+
+const DAY_MS = 86_400_000;
+const ISO_DATE = /^(\d{4})-(\d{2})-(\d{2})$/;
+
+/** True for a real calendar date written 'YYYY-MM-DD' (so not '2026-02-30'). */
+export function isIsoDate(value) {
+  if (typeof value !== 'string') return false;
+  const match = ISO_DATE.exec(value);
+  if (!match) return false;
+  const [year, month, day] = match.slice(1).map(Number);
+  const probe = new Date(Date.UTC(year, month - 1, day));
+  return (
+    probe.getUTCFullYear() === year && probe.getUTCMonth() === month - 1 && probe.getUTCDate() === day
+  );
+}
+
+function assertIsoDate(value, name = 'date') {
+  if (!isIsoDate(value)) {
+    throw new TypeError(`${name} must be a calendar date written YYYY-MM-DD, got ${JSON.stringify(value)}`);
+  }
+}
+
+const toDayNumber = (iso) => {
+  const [year, month, day] = iso.split('-').map(Number);
+  return Date.UTC(year, month - 1, day) / DAY_MS;
+};
+const fromDayNumber = (n) => new Date(n * DAY_MS).toISOString().slice(0, 10);
+
+// Intl formatters are comparatively expensive to build and this runs on every
+// render of the Coach page, so one per zone is kept.
+const formatters = new Map();
+function partsFormatter(timeZone) {
+  if (!formatters.has(timeZone)) {
+    formatters.set(
+      timeZone,
+      new Intl.DateTimeFormat('en-US', { timeZone, year: 'numeric', month: '2-digit', day: '2-digit' }),
+    );
+  }
+  return formatters.get(timeZone);
+}
+
+/**
+ * The club's calendar date for an instant, or a calendar date passed through.
+ *
+ * A string is already a calendar date and is returned unchanged (after
+ * validation) — re-interpreting '2026-09-29' as an instant is exactly trap 2.
+ * A Date is read on the club's clock, not the browser's and not UTC.
+ */
+export function clubDate(input = new Date(), timeZone = CLUB_TIME_ZONE) {
+  if (typeof input === 'string') {
+    assertIsoDate(input);
+    return input;
+  }
+  if (!(input instanceof Date) || Number.isNaN(input.getTime())) {
+    throw new TypeError(`expected a Date or a YYYY-MM-DD string, got ${JSON.stringify(input)}`);
+  }
+  const parts = Object.fromEntries(
+    partsFormatter(timeZone)
+      .formatToParts(input)
+      .map((p) => [p.type, p.value]),
+  );
+  return `${parts.year}-${parts.month}-${parts.day}`;
+}
+
+/** Day of the week of a calendar date, 0 = Sunday. Zone-free by construction. */
+export function weekdayOf(iso) {
+  assertIsoDate(iso);
+  return new Date(toDayNumber(iso) * DAY_MS).getUTCDay();
+}
+
+export const isSessionDay = (iso) => weekdayOf(iso) === CLUB_WEEKDAY;
+
+/** Calendar arithmetic: whole days, never milliseconds across a DST change. */
+export function addDays(iso, days) {
+  assertIsoDate(iso);
+  if (!Number.isInteger(days)) throw new RangeError(`days must be a whole number, got ${days}`);
+  return fromDayNumber(toDayNumber(iso) + days);
+}
+
+/**
+ * The cancelled-dates list as a Set, ignoring anything that is not a real
+ * date. It comes from database rows and localStorage, so one malformed entry
+ * must not take the Coach page down with it.
+ */
+export function normaliseSkipList(skip = []) {
+  const out = new Set();
+  if (skip == null) return out;
+  for (const entry of skip) if (isIsoDate(entry)) out.add(entry);
+  return out;
+}
+
+const sessionOnOrAfter = (iso) => addDays(iso, (CLUB_WEEKDAY - weekdayOf(iso) + 7) % 7);
+const sessionOnOrBefore = (iso) => addDays(iso, -((weekdayOf(iso) - CLUB_WEEKDAY + 7) % 7));
+
+function assertCount(n, name) {
+  if (!Number.isInteger(n) || n < 0) throw new RangeError(`${name} must be a whole number ≥ 0, got ${n}`);
+}
+
+/**
+ * The next `n` sessions on or after `fromDate` (a Tuesday counts as its own
+ * next session), leaving out cancelled dates.
+ */
+export function upcomingSessions(fromDate, n, { skip = [] } = {}) {
+  assertCount(n, 'n');
+  const skipped = normaliseSkipList(skip);
+  const out = [];
+  // Terminates: every pass either adds a date or consumes one of a finite
+  // number of skipped dates.
+  for (let date = sessionOnOrAfter(clubDate(fromDate)); out.length < n; date = addDays(date, 7)) {
+    if (!skipped.has(date)) out.push(date);
+  }
+  return out;
+}
+
+/**
+ * The session attendance is for: today on a Tuesday, otherwise the last
+ * Tuesday — skipping back past any the coach cancelled, because nobody took
+ * attendance at a meeting that did not happen.
+ */
+export function mostRecentSession(today = new Date(), { skip = [] } = {}) {
+  const skipped = normaliseSkipList(skip);
+  let date = sessionOnOrBefore(clubDate(today));
+  while (skipped.has(date)) date = addDays(date, -7);
+  return date;
+}
+
+/**
+ * The strip of Tuesdays the Coach page shows: `past` before the current one,
+ * the current one, and `future` after it. Cancelled dates are INCLUDED and
+ * flagged, not dropped, so the coach can see a holiday and undo it.
+ */
+export function sessionStrip(today = new Date(), { past = 3, future = 3, skip = [] } = {}) {
+  assertCount(past, 'past');
+  assertCount(future, 'future');
+  const skipped = normaliseSkipList(skip);
+  const now = clubDate(today);
+  const anchor = sessionOnOrBefore(now);
+  const out = [];
+  for (let i = -past; i <= future; i += 1) {
+    const date = addDays(anchor, i * 7);
+    out.push({
+      date,
+      cancelled: skipped.has(date),
+      when: date < now ? 'past' : date === now ? 'today' : 'upcoming',
+    });
+  }
+  return out;
+}
+
+/**
+ * 'Tue, Sep 29', optionally with the year or without the weekday. Formatted in
+ * UTC because the date is zone-free: formatting it in the browser's zone is
+ * trap 2 above.
+ */
+export function formatSessionDate(iso, { withYear = false, withWeekday = true } = {}) {
+  assertIsoDate(iso);
+  return new Intl.DateTimeFormat('en-US', {
+    timeZone: 'UTC',
+    ...(withWeekday ? { weekday: 'short' } : {}),
+    month: 'short',
+    day: 'numeric',
+    ...(withYear ? { year: 'numeric' } : {}),
+  }).format(new Date(toDayNumber(iso) * DAY_MS));
+}
+
+/* ─────────────── over stored session records ({sessionDate, cancelled, plan}) ─────────────── */
+
+/** The cancelled dates among stored session records. */
+export function cancelledDates(records = []) {
+  return (records || [])
+    .filter((r) => r && r.cancelled && isIsoDate(r.sessionDate))
+    .map((r) => r.sessionDate)
+    .sort();
+}
+
+/**
+ * The most recent saved plan strictly before `date`: what the planner must not
+ * repeat. A cancelled session's plan never ran, so it does not count.
+ */
+export function latestPlanBefore(records = [], date) {
+  assertIsoDate(date);
+  let best = null;
+  for (const r of records || []) {
+    if (!r || !r.plan || r.cancelled || !isIsoDate(r.sessionDate) || r.sessionDate >= date) continue;
+    if (!best || r.sessionDate > best.sessionDate) best = r;
+  }
+  return best ? best.plan : null;
+}
diff --git a/src/data/sessions.test.js b/src/data/sessions.test.js
new file mode 100644
index 0000000..8a8abfd
--- /dev/null
+++ b/src/data/sessions.test.js
@@ -0,0 +1,231 @@
+/*
+ * The Tuesday calendar. Most of these are about one failure: a Tuesday that
+ * quietly becomes a Monday or a Wednesday because something read the date in
+ * UTC or in the browser's zone instead of on the club's clock.
+ */
+
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  CLUB_WEEKDAY,
+  isIsoDate,
+  clubDate,
+  weekdayOf,
+  isSessionDay,
+  addDays,
+  normaliseSkipList,
+  upcomingSessions,
+  mostRecentSession,
+  sessionStrip,
+  formatSessionDate,
+  cancelledDates,
+  latestPlanBefore,
+} from './sessions.js';
+
+/** Run `fn` with the process pretending to be somewhere else. */
+function inZone(tz, fn) {
+  const previous = process.env.TZ;
+  process.env.TZ = tz;
+  try {
+    return fn();
+  } finally {
+    if (previous === undefined) delete process.env.TZ;
+    else process.env.TZ = previous;
+  }
+}
+
+/* ── the calendar itself ─────────────────────────────────────────────────── */
+
+test('the club meets on Tuesday', () => {
+  assert.equal(CLUB_WEEKDAY, 2);
+  assert.equal(isSessionDay('2026-09-29'), true);
+  assert.equal(isSessionDay('2026-09-25'), false); // a Friday
+  assert.equal(weekdayOf('2026-10-24'), 6); // the tournament is a Saturday
+});
+
+test('isIsoDate accepts real dates only', () => {
+  assert.equal(isIsoDate('2026-09-29'), true);
+  assert.equal(isIsoDate('2028-02-29'), true); // leap day
+  for (const bad of ['2026-02-29', '2026-02-30', '2026-13-01', '2026-9-29', '2026-09-29T00:00', '', null, undefined, 20260929, {}]) {
+    assert.equal(isIsoDate(bad), false, `${JSON.stringify(bad)} is not a date`);
+  }
+});
+
+test('addDays is calendar arithmetic, across month, year and leap boundaries', () => {
+  assert.equal(addDays('2026-09-29', 7), '2026-10-06');
+  assert.equal(addDays('2026-12-29', 7), '2027-01-05');
+  assert.equal(addDays('2028-02-22', 7), '2028-02-29');
+  assert.equal(addDays('2026-10-06', -7), '2026-09-29');
+  assert.throws(() => addDays('2026-09-29', 1.5), RangeError);
+  assert.throws(() => addDays('not a date', 1), TypeError);
+});
+
+/* ── midnight: the date is read on the club's clock ──────────────────────── */
+
+test('late Tuesday evening in Dallas is still Tuesday, though UTC says Wednesday', () => {
+  // 23:30 CDT on Tue 29 Sep = 04:30 UTC on Wed 30 Sep.
+  const lateTuesday = new Date('2026-09-30T04:30:00Z');
+  assert.equal(lateTuesday.toISOString().slice(0, 10), '2026-09-30'); // the old bug
+  assert.equal(clubDate(lateTuesday), '2026-09-29');
+  assert.equal(mostRecentSession(lateTuesday), '2026-09-29');
+});
+
+test('late Monday evening in Dallas is Monday, though UTC already says Tuesday', () => {
+  // 23:30 CDT on Mon 28 Sep = 04:30 UTC on Tue 29 Sep.
+  const lateMonday = new Date('2026-09-29T04:30:00Z');
+  assert.equal(clubDate(lateMonday), '2026-09-28');
+  assert.equal(mostRecentSession(lateMonday), '2026-09-22');
+  assert.deepEqual(upcomingSessions(lateMonday, 1), ['2026-09-29']);
+});
+
+test('one minute either side of Chicago midnight on a Tuesday', () => {
+  // 00:00 CDT Tue 29 Sep = 05:00 UTC.
+  assert.equal(mostRecentSession(new Date('2026-09-29T04:59:00Z')), '2026-09-22');
+  assert.equal(mostRecentSession(new Date('2026-09-29T05:00:00Z')), '2026-09-29');
+  // And the end of that Tuesday: 23:59 CDT = 04:59 UTC Wednesday.
+  assert.equal(mostRecentSession(new Date('2026-09-30T04:59:00Z')), '2026-09-29');
+  assert.equal(mostRecentSession(new Date('2026-09-30T05:00:00Z')), '2026-09-29'); // Wednesday: last Tuesday
+});
+
+test('the answer does not depend on the zone the browser is in', () => {
+  const instant = new Date('2026-09-30T04:30:00Z');
+  for (const tz of ['UTC', 'America/Chicago', 'Pacific/Kiritimati', 'Pacific/Pago_Pago', 'Asia/Kolkata']) {
+    inZone(tz, () => {
+      assert.equal(clubDate(instant), '2026-09-29', tz);
+      assert.equal(mostRecentSession(instant), '2026-09-29', tz);
+      assert.deepEqual(upcomingSessions('2026-10-27', 2), ['2026-10-27', '2026-11-03'], tz);
+      assert.equal(formatSessionDate('2026-09-29'), 'Tue, Sep 29', tz);
+    });
+  }
+});
+
+test('a date-only string is not re-read as an instant (the "Mon, Sep 28" trap)', () => {
+  inZone('America/Chicago', () => {
+    // The naive route: midnight UTC is Monday evening in Chicago.
+    assert.equal(new Date('2026-09-29').getDay(), 1);
+    assert.equal(clubDate('2026-09-29'), '2026-09-29');
+    assert.equal(formatSessionDate('2026-09-29'), 'Tue, Sep 29');
+    assert.equal(formatSessionDate('2026-09-29', { withYear: true }), 'Tue, Sep 29, 2026');
+    assert.equal(formatSessionDate('2026-09-29', { withWeekday: false }), 'Sep 29');
+    assert.throws(() => formatSessionDate('Sep 29'), TypeError);
+  });
+});
+
+/* ── DST ─────────────────────────────────────────────────────────────────── */
+
+test('the Tuesday after DST ends (Sun 1 Nov 2026) is read in CST, not CDT', () => {
+  // 23:30 CST Tue 3 Nov = 05:30 UTC Wed 4 Nov. Under CDT's offset it would be 00:30 Wednesday.
+  assert.equal(clubDate(new Date('2026-11-04T05:30:00Z')), '2026-11-03');
+  assert.equal(mostRecentSession(new Date('2026-11-04T05:30:00Z')), '2026-11-03');
+  // 23:30 CST Mon 2 Nov = 05:30 UTC Tue 3 Nov.
+  assert.equal(mostRecentSession(new Date('2026-11-03T05:30:00Z')), '2026-10-27');
+});
+
+test('the Tuesday after DST starts (Sun 14 Mar 2027) is read in CDT', () => {
+  // 23:30 CDT Tue 16 Mar = 04:30 UTC Wed 17 Mar.
+  assert.equal(mostRecentSession(new Date('2027-03-17T04:30:00Z')), '2027-03-16');
+  // 23:30 CDT Mon 15 Mar = 04:30 UTC Tue 16 Mar.
+  assert.equal(mostRecentSession(new Date('2027-03-16T04:30:00Z')), '2027-03-09');
+});
+
+test('weekly sessions stay on Tuesday straight through both DST changes', () => {
+  const autumn = upcomingSessions('2026-10-20', 4);
+  assert.deepEqual(autumn, ['2026-10-20', '2026-10-27', '2026-11-03', '2026-11-10']);
+  const spring = upcomingSessions('2027-03-01', 4);
+  assert.deepEqual(spring, ['2027-03-02', '2027-03-09', '2027-03-16', '2027-03-23']);
+  for (const d of [...autumn, ...spring]) assert.equal(weekdayOf(d), 2, d);
+});
+
+/* ── upcoming / most recent ──────────────────────────────────────────────── */
+
+test('upcomingSessions counts a Tuesday as its own next session', () => {
+  assert.deepEqual(upcomingSessions('2026-09-29', 2), ['2026-09-29', '2026-10-06']);
+  assert.deepEqual(upcomingSessions('2026-09-25', 3), ['2026-09-29', '2026-10-06', '2026-10-13']);
+  assert.deepEqual(upcomingSessions('2026-09-30', 1), ['2026-10-06']);
+});
+
+test('upcomingSessions still returns n sessions when some are cancelled', () => {
+  const skip = ['2026-11-24', '2026-12-22', '2026-12-29']; // Thanksgiving week, winter break
+  assert.deepEqual(upcomingSessions('2026-11-17', 4, { skip }), [
+    '2026-11-17', '2026-12-01', '2026-12-08', '2026-12-15',
+  ]);
+  assert.deepEqual(upcomingSessions('2026-12-20', 1, { skip }), ['2027-01-05']);
+});
+
+test('mostRecentSession: today on a Tuesday, otherwise the last Tuesday', () => {
+  assert.equal(mostRecentSession('2026-09-29'), '2026-09-29');
+  assert.equal(mostRecentSession('2026-09-25'), '2026-09-22'); // Friday
+  assert.equal(mostRecentSession('2026-09-28'), '2026-09-22'); // Monday
+  assert.equal(mostRecentSession('2026-10-04'), '2026-09-29'); // Sunday
+});
+
+test('mostRecentSession skips back past cancelled Tuesdays', () => {
+  assert.equal(mostRecentSession('2026-12-30', { skip: ['2026-12-29', '2026-12-22'] }), '2026-12-15');
+  // A cancelled Tuesday that is today is not the session either.
+  assert.equal(mostRecentSession('2026-09-29', { skip: ['2026-09-29'] }), '2026-09-22');
+});
+
+test('upcomingSessions and mostRecentSession reject bad input rather than guessing', () => {
+  assert.deepEqual(upcomingSessions('2026-09-25', 0), []);
+  for (const n of [-1, 1.5, NaN, '3', undefined]) {
+    assert.throws(() => upcomingSessions('2026-09-25', n), RangeError, String(n));
+  }
+  assert.throws(() => upcomingSessions('2026-02-30', 1), TypeError);
+  assert.throws(() => mostRecentSession('29/09/2026'), TypeError);
+  assert.throws(() => mostRecentSession(new Date('nonsense')), TypeError);
+  assert.throws(() => mostRecentSession(1759190400000), TypeError);
+});
+
+test('a malformed skip list entry is ignored, not fatal', () => {
+  const skip = normaliseSkipList(['2026-12-22', 'soon', null, 42, '2026-02-30', '2026-12-22']);
+  assert.deepEqual([...skip], ['2026-12-22']);
+  assert.equal(normaliseSkipList(null).size, 0);
+  assert.equal(mostRecentSession('2026-12-23', { skip: ['garbage'] }), '2026-12-22');
+});
+
+/* ── the strip on the Coach page ─────────────────────────────────────────── */
+
+test('the strip on a Friday: past Tuesdays, then the coming ones', () => {
+  const strip = sessionStrip('2026-09-25', { past: 2, future: 2 });
+  assert.deepEqual(strip.map((s) => s.date), ['2026-09-08', '2026-09-15', '2026-09-22', '2026-09-29', '2026-10-06']);
+  assert.deepEqual(strip.map((s) => s.when), ['past', 'past', 'past', 'upcoming', 'upcoming']);
+});
+
+test('the strip on a Tuesday marks today, and shows cancelled Tuesdays instead of hiding them', () => {
+  const strip = sessionStrip('2026-09-29', { past: 1, future: 1, skip: ['2026-10-06'] });
+  assert.deepEqual(strip, [
+    { date: '2026-09-22', cancelled: false, when: 'past' },
+    { date: '2026-09-29', cancelled: false, when: 'today' },
+    { date: '2026-10-06', cancelled: true, when: 'upcoming' },
+  ]);
+  assert.throws(() => sessionStrip('2026-09-29', { past: -1 }), RangeError);
+});
+
+/* ── stored records ──────────────────────────────────────────────────────── */
+
+test('cancelledDates reads only real, cancelled records', () => {
+  const records = [
+    { sessionDate: '2026-12-29', cancelled: true },
+    { sessionDate: '2026-12-22', cancelled: true },
+    { sessionDate: '2026-12-15', cancelled: false, plan: {} },
+    { sessionDate: 'bad', cancelled: true },
+    null,
+  ];
+  assert.deepEqual(cancelledDates(records), ['2026-12-22', '2026-12-29']);
+  assert.deepEqual(cancelledDates(undefined), []);
+});
+
+test('latestPlanBefore finds the last plan that actually ran before the date', () => {
+  const records = [
+    { sessionDate: '2026-09-22', plan: { id: 'a' } },
+    { sessionDate: '2026-09-29', plan: { id: 'b' } },
+    { sessionDate: '2026-10-06', plan: { id: 'c' }, cancelled: true }, // never happened
+    { sessionDate: '2026-10-13', plan: { id: 'd' } },
+    { sessionDate: '2026-10-20', plan: null },
+  ];
+  assert.deepEqual(latestPlanBefore(records, '2026-10-13'), { id: 'b' });
+  assert.deepEqual(latestPlanBefore(records, '2026-10-27'), { id: 'd' });
+  assert.equal(latestPlanBefore(records, '2026-09-22'), null); // not its own plan
+  assert.equal(latestPlanBefore([], '2026-09-22'), null);
+  assert.throws(() => latestPlanBefore(records, 'next week'), TypeError);
+});
diff --git a/src/styles/sessions.css b/src/styles/sessions.css
new file mode 100644
index 0000000..1018388
--- /dev/null
+++ b/src/styles/sessions.css
@@ -0,0 +1,352 @@
+/*
+ * sessions.css — the Tuesday strip, attendance locking and the session plan.
+ * Its own file so the feature can be read (and removed) in one place; it uses
+ * the tokens defined in app.css and nothing else.
+ */
+
+/* ---------- the strip of Tuesdays --------------------------------------- */
+
+.session-strip {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  /* Four to a row on a phone, all eight in one row on a laptop. */
+  grid-template-columns: repeat(auto-fill, minmax(64px, 1fr));
+  gap: 6px;
+}
+
+.session-chip {
+  width: 100%;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 1px;
+  padding: 6px 4px;
+  background: var(--bg-sunken);
+  color: var(--text);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  font-family: inherit;
+  cursor: pointer;
+  transition: border-color 0.12s, background 0.12s;
+}
+
+.session-chip:hover {
+  border-color: var(--border-strong);
+}
+
+.session-chip.selected {
+  border-color: var(--accent);
+  background: var(--accent-soft);
+}
+
+.session-chip-date {
+  font-size: 0.86rem;
+  font-weight: 600;
+  white-space: nowrap;
+}
+
+.session-chip-status {
+  font-size: 0.7rem;
+  color: var(--text-muted);
+  white-space: nowrap;
+}
+
+.session-chip.today .session-chip-status {
+  color: var(--accent);
+  font-weight: 600;
+}
+
+.session-chip.cancelled .session-chip-date {
+  text-decoration: line-through;
+  color: var(--text-muted);
+}
+
+.session-chip.cancelled .session-chip-status {
+  color: var(--bad);
+}
+
+/* ---------- the selected session ---------------------------------------- */
+
+.session-selected {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px 16px;
+  margin-top: 12px;
+}
+
+.session-selected-title {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px;
+}
+
+.session-actions {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px 16px;
+}
+
+.session-other-date {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 0.82rem;
+  color: var(--text-muted);
+}
+
+.session-other-date input {
+  background: var(--bg-sunken);
+  color: var(--text);
+  border: 1px solid var(--border);
+  border-radius: 7px;
+  padding: 4px 8px;
+  font-family: inherit;
+  font-size: 0.85rem;
+}
+
+.badge.session-badge-cancelled {
+  color: var(--bad);
+  border-color: var(--bad);
+}
+
+.attendance-list.session-locked li {
+  opacity: 0.6;
+}
+
+.attendance-buttons button:disabled {
+  cursor: not-allowed;
+}
+
+/* ---------- the plan ---------------------------------------------------- */
+
+.session-plan-target select {
+  max-width: 100%;
+}
+
+.session-plan-basis {
+  margin-top: 0;
+}
+
+.session-plan-actions {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px;
+  margin-top: 8px;
+}
+
+.session-plan-actions button {
+  background: var(--bg-sunken);
+  color: var(--text);
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  padding: 8px 12px;
+  font-size: 0.88rem;
+  cursor: pointer;
+}
+
+.session-plan-actions button.primary {
+  background: var(--accent);
+  color: var(--accent-text);
+  border-color: var(--accent);
+}
+
+.session-plan-actions button:hover:not(:disabled) {
+  border-color: var(--border-strong);
+}
+
+.badge.session-badge-saved {
+  color: var(--good);
+  border-color: var(--good);
+}
+
+.badge.session-badge-general {
+  color: var(--warn);
+  border-color: var(--warn);
+}
+
+.session-plan-error {
+  color: var(--bad);
+}
+
+.session-plan-body {
+  margin-top: 14px;
+  border-top: 1px solid var(--border);
+  padding-top: 12px;
+}
+
+.session-plan-heading {
+  margin-top: 0;
+}
+
+.session-plan-note {
+  padding: 8px 12px;
+  border: 1px solid var(--warn);
+  border-radius: var(--radius);
+  background: var(--bg-sunken);
+  font-size: 0.88rem;
+}
+
+.session-agenda {
+  list-style: none;
+  margin: 10px 0 0;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.session-agenda li {
+  display: grid;
+  grid-template-columns: 7.5em minmax(0, 1fr);
+  gap: 10px;
+  padding: 6px 10px;
+  background: var(--bg-sunken);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+}
+
+.session-agenda-time {
+  color: var(--text-muted);
+  font-size: 0.82rem;
+  padding-top: 1px;
+}
+
+.session-agenda-what {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  font-size: 0.86rem;
+  min-width: 0;
+}
+
+.session-agenda-what span {
+  color: var(--text-muted);
+}
+
+.session-plan-block {
+  margin-top: 16px;
+}
+
+.session-plan-block h4 {
+  margin: 0 0 4px;
+  font-size: 0.95rem;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 6px 8px;
+}
+
+.session-plan-minutes {
+  color: var(--text-muted);
+  font-weight: 400;
+  font-size: 0.82rem;
+}
+
+.session-plan-focus,
+.session-plan-sets {
+  font-size: 0.86rem;
+  margin: 4px 0;
+}
+
+.session-plan-body a {
+  color: var(--accent);
+}
+
+.session-puzzles {
+  margin: 6px 0 0;
+  padding-left: 1.6em;
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+  font-size: 0.85rem;
+}
+
+.session-puzzles li {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: 4px 10px;
+}
+
+.session-puzzle-rating {
+  min-width: 3.2em;
+}
+
+.session-puzzle-id {
+  color: var(--text-faint);
+  font-size: 0.78rem;
+}
+
+/* ---------- printing ---------------------------------------------------- */
+
+/* The print copy lives in a portal directly under <body>, so hiding the app
+   is one rule instead of fighting every positioned ancestor. */
+.session-plan-print {
+  display: none;
+}
+
+@media print {
+  body.printing-session-plan {
+    background: #fff;
+  }
+
+  body.printing-session-plan > *:not(.session-plan-print) {
+    display: none !important;
+  }
+
+  body.printing-session-plan > .session-plan-print {
+    display: block;
+    color: #000;
+    background: #fff;
+    font-size: 11pt;
+  }
+
+  .session-plan-print .session-plan-body {
+    margin: 0;
+    border: 0;
+    padding: 0;
+  }
+
+  .session-plan-print h3,
+  .session-plan-print .session-agenda-time,
+  .session-plan-print .session-agenda-what span,
+  .session-plan-print .session-plan-minutes,
+  .session-plan-print .session-puzzle-id,
+  .session-plan-print .hint-text {
+    color: #333;
+  }
+
+  .session-plan-print h3 {
+    font-size: 14pt;
+    text-transform: none;
+    letter-spacing: 0;
+  }
+
+  .session-plan-print a {
+    color: #000;
+    text-decoration: none;
+  }
+
+  .session-plan-print .badge {
+    color: #333;
+    background: none;
+    border-color: #999;
+  }
+
+  .session-plan-print .session-agenda li,
+  .session-plan-print .session-plan-note {
+    background: none;
+    border-color: #999;
+  }
+
+  .session-plan-print .session-plan-block {
+    break-inside: avoid;
+  }
+}
diff --git a/supabase/migrations/0021_club_sessions.sql b/supabase/migrations/0021_club_sessions.sql
new file mode 100644
index 0000000..4a57c5d
--- /dev/null
+++ b/supabase/migrations/0021_club_sessions.sql
@@ -0,0 +1,83 @@
+-- 0021 — club sessions: what is remembered about individual Tuesdays.
+--
+-- NOT YET APPLIED. Written without database access; the lead applies it.
+--
+-- Additive only. Creates one table with its policies, a trigger and a
+-- realtime registration. Alters, drops and rewrites nothing that exists —
+-- in particular the attendance table (0007) and its policies are untouched:
+-- attendance rows are still one per player per session_date, and a session
+-- does not need a row here for attendance to be taken against it. Safe to run
+-- twice.
+--
+-- WHY A SPARSE TABLE. The club meets every Tuesday, so the app derives
+-- sessions from the calendar (src/data/sessions.js) instead of making the
+-- coach create one each week. A row exists only when a Tuesday differs from
+-- the default: it was cancelled (a holiday), or a lesson plan was saved for
+-- it (src/analysis/sessionPlanner.js). A missing row is never a missing
+-- session.
+--
+-- session_date is a DATE, not a timestamp, for the same reason as
+-- attendance.session_date: a meeting is a calendar day in Dallas, and a
+-- timestamptz would move a late Tuesday evening into Wednesday in UTC.
+--
+-- Depends on 0005's helpers (is_coach, is_approved) and 0011's
+-- touch_updated_at().
+
+create table if not exists public.club_sessions (
+  id            bigserial primary key,
+  session_date  date not null unique,
+  cancelled     boolean not null default false,
+  plan          jsonb check (plan is null or jsonb_typeof(plan) = 'object'),
+  notes         text not null default '',
+  created_by    uuid default auth.uid() references auth.users(id) on delete set null,
+  created_at    timestamptz not null default now(),
+  updated_at    timestamptz not null default now()
+);
+
+comment on table public.club_sessions is
+  'One row per Tuesday that differs from the default: cancelled, or has a saved lesson plan. Sessions without a row still exist.';
+comment on column public.club_sessions.plan is
+  'sessionPlanner.js output: focus blocks, puzzle ids, timed agenda. Puzzle ids refer to src/data/puzzles.json.';
+
+-- Covering index for the foreign key, as 0013 does for the other tables.
+create index if not exists club_sessions_created_by_idx on public.club_sessions (created_by);
+
+drop trigger if exists club_sessions_touch_updated_at on public.club_sessions;
+create trigger club_sessions_touch_updated_at
+  before update on public.club_sessions
+  for each row execute function public.touch_updated_at();
+
+-- ---------------------------------------------------------------------------
+-- Policies, in 0013's shape: exactly one SELECT policy, and writes split into
+-- INSERT / UPDATE / DELETE rather than FOR ALL (which would add a second
+-- permissive SELECT policy to every read).
+--
+-- Every approved member may read: the schedule and the lesson plan are club
+-- information, not a judgement about any one child. Only coaches write.
+-- ---------------------------------------------------------------------------
+alter table public.club_sessions enable row level security;
+
+drop policy if exists club_sessions_select on public.club_sessions;
+create policy club_sessions_select on public.club_sessions
+  for select to authenticated using (public.is_approved());
+
+drop policy if exists club_sessions_insert on public.club_sessions;
+create policy club_sessions_insert on public.club_sessions
+  for insert to authenticated with check (public.is_coach());
+
+drop policy if exists club_sessions_update on public.club_sessions;
+create policy club_sessions_update on public.club_sessions
+  for update to authenticated using (public.is_coach()) with check (public.is_coach());
+
+drop policy if exists club_sessions_delete on public.club_sessions;
+create policy club_sessions_delete on public.club_sessions
+  for delete to authenticated using (public.is_coach());
+
+-- Realtime, so a cancellation made on one device shows on the others.
+do $$
+begin
+  alter publication supabase_realtime add table public.club_sessions;
+exception
+  when duplicate_object then null;
+end
+$$;
