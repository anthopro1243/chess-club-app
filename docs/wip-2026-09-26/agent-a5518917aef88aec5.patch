+import { useMemo, useState } from 'react';
+import { setAttendance } from '../data/rosterStore.js';
+import { useClubSessions, setSessionCancelled } from '../data/clubSessionsStore.js';
+import {
+  cancelledDates,
+  clubDate,
+  formatSessionDate,
+  isIsoDate,
+  isSessionDay,
+  mostRecentSession,
+  sessionStrip,
+} from '../data/sessions.js';
+import InfoTooltip from './InfoTooltip.jsx';
+import '../styles/sessions.css';
+
+const STRIP_PAST = 4;
+const STRIP_FUTURE = 3;
+
+/**
+ * SessionAttendance — the Coach page's attendance panel, organised by Tuesday.
+ *
+ * It opens on the session the coach is most likely taking attendance for
+ * (today on a Tuesday, otherwise the last Tuesday that was not cancelled),
+ * rather than on today's date: on a Wednesday "today" is a day the club did
+ * not meet. Sessions come from the calendar, so there is nothing to create.
+ */
+export default function SessionAttendance({ players }) {
+  const sessions = useClubSessions();
+  const cancelled = useMemo(() => cancelledDates(sessions), [sessions]);
+  const cancelledSet = useMemo(() => new Set(cancelled), [cancelled]);
+  // The club's date, not UTC's: a late Tuesday session is still Tuesday.
+  const today = clubDate();
+  const defaultDate = useMemo(() => mostRecentSession(today, { skip: cancelled }), [today, cancelled]);
+  // Null until the coach picks one, so the default can still follow a
+  // cancellation that arrives from the cloud after the page opened.
+  const [picked, setPicked] = useState(null);
+  const sessionDate = picked ?? defaultDate;
+  const strip = useMemo(
+    () => sessionStrip(today, { past: STRIP_PAST, future: STRIP_FUTURE, skip: cancelled }),
+    [today, cancelled],
+  );
+
+  const attendanceOn = (player, date) => (player.attendance || []).find((a) => a.date === date) ?? null;
+  const presentOn = (date) => players.filter((p) => attendanceOn(p, date)?.present === true).length;
+  const recordedOn = (date) => players.some((p) => attendanceOn(p, date) != null);
+
+  const onSchedule = isSessionDay(sessionDate);
+  const isCancelled = cancelledSet.has(sessionDate);
+  const isUpcoming = sessionDate > today;
+  const locked = isCancelled || isUpcoming;
+  const alreadyTaken = recordedOn(sessionDate);
+  const presentCount = presentOn(sessionDate);
+
+  const toggleCancelled = () => {
+    // Pin the selection, or cancelling the default session would jump the
+    // panel to the Tuesday before.
+    setPicked(sessionDate);
+    setSessionCancelled(sessionDate, !isCancelled);
+  };
+
+  const stripLabel = (s) => {
+    if (s.cancelled) return 'Cancelled';
+    if (s.when === 'today') return 'Today';
+    if (s.when === 'upcoming') return 'Upcoming';
+    return recordedOn(s.date) ? `${presentOn(s.date)} present` : 'Not taken';
+  };
+
+  return (
+    <section className="panel">
+      <div className="panel-header">
+        <h2>
+          Attendance
+          <InfoTooltip>
+            Every Tuesday is a session automatically. Pick one below; the panel opens on today if it
+            is Tuesday, otherwise on the last Tuesday. Mark a holiday as cancelled so it is skipped.
+          </InfoTooltip>
+        </h2>
+        <span className="badge">
+          {presentCount} / {players.length} present
+        </span>
+      </div>
+
+      <ul className="session-strip" aria-label="Tuesday sessions">
+        {strip.map((s) => (
+          <li key={s.date}>
+            <button
+              type="button"
+              className={`session-chip ${s.date === sessionDate ? 'selected' : ''} ${s.cancelled ? 'cancelled' : ''} ${s.when}`}
+              aria-pressed={s.date === sessionDate}
+              onClick={() => setPicked(s.date)}
+            >
+              <span className="session-chip-date">{formatSessionDate(s.date, { withWeekday: false })}</span>
+              <span className="session-chip-status">{stripLabel(s)}</span>
+            </button>
+          </li>
+        ))}
+      </ul>
+
+      <div className="session-selected">
+        <div className="session-selected-title">
+          <strong>{formatSessionDate(sessionDate, { withYear: true })}</strong>
+          {isCancelled && <span className="badge session-badge-cancelled">Cancelled</span>}
+          {!onSchedule && <span className="badge">Not a Tuesday</span>}
+        </div>
+        <div className="session-actions">
+          {onSchedule &&
+            (isCancelled ? (
+              <button type="button" className="link-button" onClick={toggleCancelled}>
+                Restore session
+              </button>
+            ) : (
+              <button
+                type="button"
+                className="link-button danger"
+                onClick={toggleCancelled}
+                disabled={alreadyTaken}
+                title={alreadyTaken ? 'Attendance was taken for this date, so the session happened.' : undefined}
+              >
+                Mark cancelled
+              </button>
+            ))}
+          <label className="session-other-date">
+            <span>Other date</span>
+            <input
+              type="date"
+              value={sessionDate}
+              onChange={(e) => {
+                if (isIsoDate(e.target.value)) setPicked(e.target.value);
+              }}
+            />
+          </label>
+        </div>
+      </div>
+
+      {isCancelled && (
+        <p className="hint-text">
+          Cancelled: the club did not meet, so there is no attendance to take. Restore it if the club
+          met after all.
+        </p>
+      )}
+      {!isCancelled && isUpcoming && (
+        <p className="hint-text">This session has not happened yet. Attendance opens on the day.</p>
+      )}
+      {!onSchedule && !locked && (
+        <p className="hint-text">
+          Not a regular Tuesday session. Attendance is still recorded against this date.
+        </p>
+      )}
+
+      {players.length === 0 ? (
+        <p className="hint-text">No players on the roster yet.</p>
+      ) : (
+        <ul className={`attendance-list ${locked ? 'session-locked' : ''}`}>
+          {players.map((p) => {
+            const state = attendanceOn(p, sessionDate)?.present ?? null;
+            return (
+              <li key={p.playerId}>
+                <span className="attendance-name">{p.name}</span>
+                <span className="attendance-buttons">
+                  <button
+                    type="button"
+                    className={state === true ? 'attend-on' : ''}
+                    disabled={locked}
+                    onClick={() => setAttendance(p.playerId, sessionDate, true)}
+                  >
+                    Present
+                  </button>
+                  <button
+                    type="button"
+                    className={state === false ? 'attend-off' : ''}
+                    disabled={locked}
+                    onClick={() => setAttendance(p.playerId, sessionDate, false)}
+                  >
+                    Absent
+                  </button>
+                </span>
+              </li>
+            );
+          })}
+        </ul>
+      )}
+    </section>
+  );
+}
