@@ -0,0 +1,362 @@
+/*
+ * sessionPlanner.js — a Tuesday lesson plan from what the club is weakest at.
+ *
+ * Input is the Club page's "where group time should go" list, i.e.
+ * weakestCategories(clubProfile(...)): the three lowest club-wide categories
+ * that are actually MEASURED. Output is a plain JSON object (it is saved as
+ * club_sessions.plan) with a short focus per category, 5–8 puzzles per focus
+ * from the shipped Lichess set, and a timed agenda for a ~60-minute meeting.
+ *
+ * Three rules shape everything here:
+ *
+ *   1. Never invent a weakness. With fewer than three measured categories the
+ *      plan says so and fills the gap with general tactics, labelled as such.
+ *      A club told "your endgames are weak" on no evidence stops trusting the
+ *      evidence when it does exist — the same reasoning as presentation.js.
+ *   2. Deterministic. The same club data and the same previous plan give the
+ *      same plan, so a coach who re-opens it on Tuesday sees what they printed
+ *      on Monday. No Math.random, no clock.
+ *   3. Fresh puzzles. Nothing from the previous plan is reused while the theme
+ *      still has unused puzzles; if it runs out, the repeats are flagged rather
+ *      than hidden.
+ */
+
+import { CATEGORY_LABELS } from './scoring.js';
+import { isIsoDate } from '../data/sessions.js';
+
+export const PLAN_VERSION = 1;
+export const SESSION_MINUTES = 60;
+export const FOCUS_COUNT = 3;
+export const MIN_PUZZLES_PER_FOCUS = 5;
+export const MAX_PUZZLES_PER_FOCUS = 8;
+export const DEFAULT_PUZZLES_PER_FOCUS = 6;
+export const WARMUP_PUZZLES = 5;
+/** Warm-ups are for getting heads into chess, not for getting stuck. */
+export const WARMUP_MAX_RATING = 1000;
+const WARMUP_THEMES = ['mateIn1', 'oneMove'];
+
+/*
+ * What to teach for each engine category, and which puzzles.json themes serve
+ * it. Theme order matters only for labelling: a puzzle is shown under the
+ * first theme in the list that it carries. The test alongside checks every
+ * theme against the shipped data, because an unknown theme filters the
+ * Training page down to nothing (see PUZZLE_THEME_BY_TRAINING_THEME).
+ *
+ * Notation is absent on purpose: it is not measurable from games and
+ * weakestCategories() already leaves it out.
+ */
+export const CATEGORY_LESSONS = Object.freeze({
+  openingKnowledge: {
+    themes: ['opening'],
+    focus:
+      'Opening principles: develop, castle, fight for the centre. Everyone should know the first moves of one line as White and one as Black.',
+    gameTip: 'After each game, write down the first eight moves and mark where you left your line.',
+  },
+  tacticalVision: {
+    themes: ['fork', 'pin', 'skewer', 'discoveredAttack', 'deflection'],
+    focus:
+      'Checks, captures, threats. Before every move, scan for forks, pins and skewers, for both sides.',
+    gameTip: 'Before each move, name one forcing move for you and one for your opponent.',
+  },
+  positionalUnderstanding: {
+    themes: ['quietMove', 'zugzwang', 'advancedPawn'],
+    focus:
+      'When nothing is forcing: find the worst-placed piece and improve it, and name a plan before moving.',
+    gameTip: 'At move 15, write a one-line plan on the scoresheet before playing on.',
+  },
+  endgameTechnique: {
+    themes: ['rookEndgame', 'pawnEndgame', 'endgame'],
+    focus:
+      'Converting the win: an active king, passed pawns, the opposition, and rooks behind passed pawns.',
+    gameTip: 'Play out a set endgame position instead of a full game, then swap colours.',
+  },
+  timeManagement: {
+    themes: ['mateIn1', 'oneMove'],
+    focus:
+      'Spend time where it matters: fast on the obvious move, slow on the critical one. Solve these against a clock, about 30 seconds each.',
+    gameTip: 'Use a clock, and write the time left on the scoresheet every ten moves.',
+  },
+  boardVision: {
+    themes: ['hangingPiece', 'trappedPiece', 'mateIn1'],
+    focus:
+      'Blunder check before every move: what did my opponent just attack, and what am I leaving undefended?',
+    gameTip: 'Before touching a piece, check which squares and pieces it stops guarding.',
+  },
+  psychologicalResilience: {
+    themes: ['defensiveMove', 'intermezzo', 'quietMove'],
+    focus:
+      'Keep fighting from worse positions: look for the defensive resource and make the position complicated instead of resigning.',
+    gameTip: 'No resigning today: every game is played to mate or a draw.',
+  },
+});
+
+/** Filler for a missing measured category. Labelled as general, never as a weakness. */
+export const GENERAL_TACTICS = Object.freeze([
+  {
+    key: 'doubleAttacks',
+    label: 'General tactics: double attacks',
+    themes: ['fork', 'discoveredAttack', 'skewer'],
+    focus: 'Double attacks: forks, discovered attacks and skewers. One move, two threats.',
+  },
+  {
+    key: 'matingPatterns',
+    label: 'General tactics: mating patterns',
+    themes: ['backRankMate', 'mateIn2', 'smotheredMate'],
+    focus: 'Mating patterns: back-rank mates, smothered mates and mate in two.',
+  },
+  {
+    key: 'pinsAndDeflections',
+    label: 'General tactics: pins and deflections',
+    themes: ['pin', 'deflection', 'attraction'],
+    focus: 'Pins and deflections: pieces that cannot move, and defenders that can be pulled away.',
+  },
+]);
+
+const GENERAL_GAME_TIP = 'Before each move, look for checks, captures and threats, for both sides.';
+
+/** 'discoveredAttack' -> 'Discovered attack'; matches the Training page's wording. */
+export const themeLabel = (theme) =>
+  String(theme)
+    .replace(/([a-z])([A-Z])/g, '$1 $2')
+    .replace(/([a-zA-Z])(\d)/g, '$1 $2')
+    .toLowerCase()
+    .replace(/^./, (c) => c.toUpperCase());
+
+/** The Training page, pre-filtered to one theme (App.jsx routes on the hash). */
+export const trainingHref = (theme) => `#/training?theme=${encodeURIComponent(theme)}`;
+
+/** Every puzzle id a saved plan used. Tolerates an old or malformed plan. */
+export function puzzleIdsInPlan(plan) {
+  const ids = new Set();
+  if (!plan || typeof plan !== 'object') return ids;
+  const lists = [plan.warmup?.puzzles, ...(Array.isArray(plan.focuses) ? plan.focuses.map((f) => f?.puzzles) : [])];
+  for (const list of lists) {
+    if (!Array.isArray(list)) continue;
+    for (const p of list) if (p && typeof p.id === 'string') ids.add(p.id);
+  }
+  return ids;
+}
+
+const byDifficulty = (a, b) => a.rating - b.rating || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0);
+
+/**
+ * `count` puzzles spread evenly from easiest to hardest across a pool already
+ * sorted by rating. Evenly spaced ranks rather than the easiest N, because one
+ * set has to serve a room rated ~600 to ~1600.
+ */
+export function spreadAcross(sorted, count) {
+  if (count <= 0) return [];
+  if (sorted.length <= count) return [...sorted];
+  if (count === 1) return [sorted[Math.floor((sorted.length - 1) / 2)]];
+  const out = [];
+  // Spacing is >= 1 here, and Math.round is monotone with round(x + 1) =
+  // round(x) + 1, so the indices are distinct.
+  for (let i = 0; i < count; i += 1) out.push(sorted[Math.round((i * (sorted.length - 1)) / (count - 1))]);
+  return out;
+}
+
+/**
+ * Pick puzzles for one block. Unused puzzles first; if the themes run out,
+ * top up from the previous plan (flagged), never from this plan.
+ */
+function choosePuzzles({ pool, count, minimum, usedThisPlan, usedLastPlan }) {
+  const eligible = pool.filter((p) => !usedThisPlan.has(p.id)).sort(byDifficulty);
+  const fresh = eligible.filter((p) => !usedLastPlan.has(p.id));
+  let chosen = spreadAcross(fresh, count).map((p) => ({ puzzle: p, repeated: false }));
+  if (chosen.length < minimum) {
+    const repeats = spreadAcross(
+      eligible.filter((p) => usedLastPlan.has(p.id)),
+      minimum - chosen.length,
+    ).map((p) => ({ puzzle: p, repeated: true }));
+    chosen = [...chosen, ...repeats].sort((a, b) => byDifficulty(a.puzzle, b.puzzle));
+  }
+  for (const { puzzle } of chosen) usedThisPlan.add(puzzle.id);
+  return chosen;
+}
+
+function toPlanPuzzle({ puzzle, repeated }, themes) {
+  const theme = themes.find((t) => puzzle.themes.includes(t)) ?? themes[0];
+  return {
+    id: puzzle.id,
+    rating: puzzle.rating,
+    name: puzzle.name || themeLabel(theme),
+    theme,
+    href: trainingHref(theme),
+    ...(repeated ? { repeated: true } : {}),
+  };
+}
+
+const poolFor = (puzzles, themes) => puzzles.filter((p) => p.themes.some((t) => themes.includes(t)));
+
+/** The weakest list, cleaned: known, measured, distinct categories, in the order given. */
+function measuredWeaknesses(weakest) {
+  const seen = new Set();
+  const out = [];
+  for (const entry of Array.isArray(weakest) ? weakest : []) {
+    const category = entry?.category;
+    if (!CATEGORY_LESSONS[category] || seen.has(category)) continue;
+    // An unmeasured category (average null) is exactly the thing rule 1 is about.
+    if (typeof entry.average !== 'number' || Number.isNaN(entry.average)) continue;
+    seen.add(category);
+    out.push(entry);
+    if (out.length === FOCUS_COUNT) break;
+  }
+  return out;
+}
+
+function coverageNote(measured) {
+  if (measured >= FOCUS_COUNT) return null;
+  if (measured === 0) {
+    return 'No skill category has enough measured data yet, so every block is general tactics. This is not a diagnosis of the club; analyse more games and re-plan.';
+  }
+  const gaps = FOCUS_COUNT - measured;
+  return `Only ${measured} ${measured === 1 ? 'category has' : 'categories have'} enough measured data to call a weakness. The other ${gaps === 1 ? 'block is' : `${gaps} blocks are`} general tactics, not a measured weakness.`;
+}
+
+/**
+ * Split `minutes` into warm-up, focus blocks, practice games and review.
+ * At 60 minutes: 10 / 20 (split across the focuses, the weakest first) / 20 / 10.
+ */
+export function buildAgenda(focuses, { minutes = SESSION_MINUTES, gameTip = GENERAL_GAME_TIP, warmupCount = WARMUP_PUZZLES } = {}) {
+  if (!Number.isInteger(minutes) || minutes < 30 || minutes > 180) {
+    throw new RangeError(`a session is 30–180 whole minutes, got ${minutes}`);
+  }
+  if (!Array.isArray(focuses) || focuses.length === 0) throw new TypeError('an agenda needs at least one focus');
+  const warmup = Math.round(minutes / 6);
+  const review = Math.round(minutes / 6);
+  const games = Math.round(minutes / 3);
+  const focusTotal = minutes - warmup - review - games;
+  const base = Math.floor(focusTotal / focuses.length);
+  const extra = focusTotal - base * focuses.length;
+
+  const items = [];
+  let clock = 0;
+  const add = (kind, length, title, detail) => {
+    items.push({ kind, start: clock, end: clock + length, minutes: length, title, detail });
+    clock += length;
+  };
+  add('warmup', warmup, 'Warm-up puzzles', `${warmupCount} quick one-move puzzles to start the room thinking. Solve each before showing the answer.`);
+  focuses.forEach((f, i) => add('focus', base + (i < extra ? 1 : 0), `Focus: ${f.label}`, f.focus));
+  add('games', games, 'Practice games', `Clocked games with scoresheets, as at a tournament. ${gameTip}`);
+  add('review', review, 'Review', 'Go over one game per board: find the moment today’s focus came up, and what the better move was.');
+  return items;
+}
+
+/**
+ * The plan for one Tuesday.
+ *
+ * @param {object}   args
+ * @param {string}   args.sessionDate  'YYYY-MM-DD'
+ * @param {object[]} args.weakest      weakestCategories(clubProfile(...)), weakest first
+ * @param {object[]} args.puzzles      the puzzle library (puzzles.json)
+ * @param {object}   [args.previousPlan] the last saved plan, whose puzzles are not reused
+ */
+export function planSession({
+  sessionDate,
+  weakest = [],
+  puzzles,
+  previousPlan = null,
+  puzzlesPerFocus = DEFAULT_PUZZLES_PER_FOCUS,
+  warmupCount = WARMUP_PUZZLES,
+  minutes = SESSION_MINUTES,
+} = {}) {
+  if (!isIsoDate(sessionDate)) throw new TypeError(`sessionDate must be YYYY-MM-DD, got ${JSON.stringify(sessionDate)}`);
+  if (!Array.isArray(puzzles)) throw new TypeError('puzzles must be the puzzle library array');
+  if (
+    !Number.isInteger(puzzlesPerFocus) ||
+    puzzlesPerFocus < MIN_PUZZLES_PER_FOCUS ||
+    puzzlesPerFocus > MAX_PUZZLES_PER_FOCUS
+  ) {
+    throw new RangeError(`puzzlesPerFocus must be ${MIN_PUZZLES_PER_FOCUS}–${MAX_PUZZLES_PER_FOCUS}, got ${puzzlesPerFocus}`);
+  }
+  if (!Number.isInteger(warmupCount) || warmupCount < 0 || warmupCount > MAX_PUZZLES_PER_FOCUS) {
+    throw new RangeError(`warmupCount must be 0–${MAX_PUZZLES_PER_FOCUS}, got ${warmupCount}`);
+  }
+
+  const library = puzzles.filter(
+    (p) => p && typeof p.id === 'string' && Array.isArray(p.themes) && Number.isFinite(p.rating),
+  );
+  const usedLastPlan = puzzleIdsInPlan(previousPlan);
+  const usedThisPlan = new Set();
+  const measured = measuredWeaknesses(weakest);
+
+  const blocks = [
+    ...measured.map((entry) => ({
+      kind: 'measured',
+      key: entry.category,
+      category: entry.category,
+      label: entry.label || CATEGORY_LABELS[entry.category] || entry.category,
+      rubricAverage: typeof entry.rubricAverage === 'number' ? entry.rubricAverage : null,
+      measured: typeof entry.measured === 'number' ? entry.measured : null,
+      ...CATEGORY_LESSONS[entry.category],
+    })),
+    ...GENERAL_TACTICS.slice(0, FOCUS_COUNT - measured.length).map((g) => ({
+      kind: 'general',
+      category: null,
+      rubricAverage: null,
+      measured: null,
+      gameTip: GENERAL_GAME_TIP,
+      ...g,
+    })),
+  ];
+
+  // Focus blocks choose before the warm-up: they are the lesson, the warm-up
+  // can make do with what is left.
+  const available = new Set(library.flatMap((p) => p.themes));
+  const focuses = blocks.map((block) => {
+    const chosen = choosePuzzles({
+      pool: poolFor(library, block.themes),
+      count: puzzlesPerFocus,
+      minimum: MIN_PUZZLES_PER_FOCUS,
+      usedThisPlan,
+      usedLastPlan,
+    });
+    const repeatedCount = chosen.filter((c) => c.repeated).length;
+    return {
+      kind: block.kind,
+      key: block.key,
+      category: block.category,
+      label: block.label,
+      rubricAverage: block.rubricAverage,
+      measured: block.measured,
+      focus: block.focus,
+      gameTip: block.gameTip,
+      sets: block.themes
+        .filter((t) => available.has(t))
+        .map((theme) => ({ theme, label: themeLabel(theme), href: trainingHref(theme) })),
+      puzzles: chosen.map((c) => toPlanPuzzle(c, block.themes)),
+      note:
+        chosen.length < MIN_PUZZLES_PER_FOCUS
+          ? `Only ${chosen.length} puzzle${chosen.length === 1 ? '' : 's'} in the library for this theme.`
+          : repeatedCount > 0
+            ? `${repeatedCount} puzzle${repeatedCount === 1 ? '' : 's'} repeat${repeatedCount === 1 ? 's' : ''} from the last plan: this theme has run out of new ones.`
+            : null,
+    };
+  });
+
+  const warmupPool = poolFor(library, WARMUP_THEMES).filter((p) => p.rating < WARMUP_MAX_RATING);
+  const warmupPuzzles = choosePuzzles({
+    pool: warmupPool,
+    count: warmupCount,
+    minimum: warmupCount,
+    usedThisPlan,
+    usedLastPlan,
+  }).map((c) => toPlanPuzzle(c, WARMUP_THEMES));
+
+  const agenda = buildAgenda(focuses, { minutes, gameTip: focuses[0].gameTip, warmupCount: warmupPuzzles.length });
+
+  return {
+    version: PLAN_VERSION,
+    sessionDate,
+    minutes,
+    measuredCount: measured.length,
+    note: coverageNote(measured.length),
+    warmup: {
+      minutes: agenda[0].minutes,
+      puzzles: warmupPuzzles,
+      sets: WARMUP_THEMES.map((theme) => ({ theme, label: themeLabel(theme), href: trainingHref(theme) })),
+    },
+    focuses: focuses.map((f, i) => ({ ...f, minutes: agenda[i + 1].minutes })),
+    agenda,
+  };
+}
diff --git a/src/analysis/sessionPlanner.test.js b/src/analysis/sessionPlanner.test.js
new file mode 100644
index 0000000..b205bfc
--- /dev/null
+++ b/src/analysis/sessionPlanner.test.js
@@ -0,0 +1,331 @@
+/*
+ * The Tuesday planner. The rules that matter most are the negative ones: it
+ * must not invent a weakness the data does not show, and it must not hand the
+ * club the same puzzles two weeks running.
+ */
+
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import {
+  planSession,
+  buildAgenda,
+  puzzleIdsInPlan,
+  spreadAcross,
+  themeLabel,
+  trainingHref,
+  CATEGORY_LESSONS,
+  GENERAL_TACTICS,
+  MIN_PUZZLES_PER_FOCUS,
+  MAX_PUZZLES_PER_FOCUS,
+  WARMUP_MAX_RATING,
+} from './sessionPlanner.js';
+import { clubProfile, weakestCategories } from './skillModel.js';
+
+const PUZZLES = JSON.parse(readFileSync(new URL('../data/puzzles.json', import.meta.url)));
+const byId = new Map(PUZZLES.map((p) => [p.id, p]));
+
+const entry = (category, average, label = category) => ({
+  category,
+  label,
+  average,
+  rubricAverage: average / 10,
+  measured: 4,
+  engineBacked: 4,
+});
+const THREE = [
+  entry('endgameTechnique', 31, 'Endgame technique'),
+  entry('boardVision', 38, 'Board vision'),
+  entry('openingKnowledge', 44, 'Opening knowledge'),
+];
+
+const allPuzzles = (plan) => [...plan.warmup.puzzles, ...plan.focuses.flatMap((f) => f.puzzles)];
+
+/* ── the data the plan is built from ─────────────────────────────────────── */
+
+test('every lesson theme exists in the shipped puzzles, with enough to fill two plans', () => {
+  const available = new Set(PUZZLES.flatMap((p) => p.themes));
+  const lessons = [...Object.values(CATEGORY_LESSONS), ...GENERAL_TACTICS];
+  for (const lesson of lessons) {
+    for (const theme of lesson.themes) assert.ok(available.has(theme), `no puzzle carries "${theme}"`);
+    const pool = PUZZLES.filter((p) => p.themes.some((t) => lesson.themes.includes(t)));
+    assert.ok(pool.length >= 2 * MAX_PUZZLES_PER_FOCUS, `${lesson.themes} has only ${pool.length} puzzles`);
+  }
+});
+
+test('notation has no lesson: it is not measurable from games', () => {
+  assert.equal(CATEGORY_LESSONS.notation, undefined);
+});
+
+/* ── three measured weaknesses ───────────────────────────────────────────── */
+
+test('three measured categories become three focus blocks, weakest first', () => {
+  const plan = planSession({ sessionDate: '2026-09-29', weakest: THREE, puzzles: PUZZLES });
+  assert.equal(plan.sessionDate, '2026-09-29');
+  assert.equal(plan.measuredCount, 3);
+  assert.equal(plan.note, null);
+  assert.deepEqual(plan.focuses.map((f) => f.category), ['endgameTechnique', 'boardVision', 'openingKnowledge']);
+  assert.ok(plan.focuses.every((f) => f.kind === 'measured'));
+  assert.equal(plan.focuses[0].rubricAverage, 3.1);
+  assert.ok(plan.focuses.every((f) => typeof f.focus === 'string' && f.focus.length > 20));
+});
+
+test('each focus has 5–8 puzzles, each carrying one of that focus’s themes', () => {
+  const plan = planSession({ sessionDate: '2026-09-29', weakest: THREE, puzzles: PUZZLES });
+  for (const focus of plan.focuses) {
+    assert.ok(focus.puzzles.length >= MIN_PUZZLES_PER_FOCUS && focus.puzzles.length <= MAX_PUZZLES_PER_FOCUS, focus.label);
+    const themes = CATEGORY_LESSONS[focus.category].themes;
+    for (const p of focus.puzzles) {
+      const source = byId.get(p.id);
+      assert.ok(source, `${p.id} is not a real puzzle`);
+      assert.ok(source.themes.some((t) => themes.includes(t)), `${p.id} does not match ${focus.label}`);
+      assert.ok(source.themes.includes(p.theme));
+      assert.equal(p.rating, source.rating);
+    }
+  }
+});
+
+test('puzzles are spread across difficulty, easiest first, not bunched at one end', () => {
+  const plan = planSession({ sessionDate: '2026-09-29', weakest: THREE, puzzles: PUZZLES });
+  for (const focus of plan.focuses) {
+    const ratings = focus.puzzles.map((p) => p.rating);
+    assert.deepEqual(ratings, [...ratings].sort((a, b) => a - b), `${focus.label} not ordered`);
+    const pool = PUZZLES
+      .filter((p) => p.themes.some((t) => CATEGORY_LESSONS[focus.category].themes.includes(t)))
+      .map((p) => p.rating)
+      .sort((a, b) => a - b);
+    const q1 = pool[Math.floor(pool.length / 4)];
+    const q3 = pool[Math.floor((pool.length * 3) / 4)];
+    assert.ok(ratings[0] <= q1, `${focus.label} starts too hard (${ratings[0]} > ${q1})`);
+    assert.ok(ratings[ratings.length - 1] >= q3, `${focus.label} tops out too easy (${ratings.at(-1)} < ${q3})`);
+  }
+});
+
+test('warm-up puzzles are easy one-movers, and nothing repeats within a plan', () => {
+  const plan = planSession({ sessionDate: '2026-09-29', weakest: THREE, puzzles: PUZZLES });
+  assert.equal(plan.warmup.puzzles.length, 5);
+  for (const p of plan.warmup.puzzles) {
+    assert.ok(p.rating < WARMUP_MAX_RATING);
+    assert.ok(['mateIn1', 'oneMove'].some((t) => byId.get(p.id).themes.includes(t)));
+  }
+  const ids = allPuzzles(plan).map((p) => p.id);
+  assert.equal(new Set(ids).size, ids.length);
+});
+
+test('the same inputs give the same plan (no randomness, no clock)', () => {
+  const a = planSession({ sessionDate: '2026-09-29', weakest: THREE, puzzles: PUZZLES });
+  const b = planSession({ sessionDate: '2026-09-29', weakest: THREE, puzzles: [...PUZZLES].reverse() });
+  assert.deepEqual(a, b);
+});
+
+test('next week’s plan does not reuse last week’s puzzles', () => {
+  const first = planSession({ sessionDate: '2026-09-29', weakest: THREE, puzzles: PUZZLES });
+  const second = planSession({ sessionDate: '2026-10-06', weakest: THREE, puzzles: PUZZLES, previousPlan: first });
+  const before = puzzleIdsInPlan(first);
+  for (const p of allPuzzles(second)) assert.ok(!before.has(p.id), `${p.id} repeated`);
+  assert.ok(allPuzzles(second).every((p) => !p.repeated));
+  // Still the same lesson, still spread.
+  assert.deepEqual(second.focuses.map((f) => f.category), first.focuses.map((f) => f.category));
+  // And a third week avoids the second, not necessarily the first.
+  const third = planSession({ sessionDate: '2026-10-13', weakest: THREE, puzzles: PUZZLES, previousPlan: second });
+  const middle = puzzleIdsInPlan(second);
+  for (const p of allPuzzles(third)) assert.ok(!middle.has(p.id));
+});
+
+test('a plan survives the round trip through jsonb', () => {
+  const plan = planSession({ sessionDate: '2026-09-29', weakest: THREE, puzzles: PUZZLES });
+  assert.deepEqual(JSON.parse(JSON.stringify(plan)), plan);
+});
+
+test('every link goes to the Training page filtered to a real theme', () => {
+  const plan = planSession({ sessionDate: '2026-09-29', weakest: THREE, puzzles: PUZZLES });
+  const available = new Set(PUZZLES.flatMap((p) => p.themes));
+  const links = [
+    ...plan.warmup.sets,
+    ...plan.focuses.flatMap((f) => f.sets),
+    ...allPuzzles(plan),
+  ];
+  for (const link of links) {
+    assert.match(link.href, /^#\/training\?theme=[A-Za-z0-9]+$/);
+    assert.ok(available.has(new URLSearchParams(link.href.split('?')[1]).get('theme')));
+  }
+});
+
+/* ── the agenda ──────────────────────────────────────────────────────────── */
+
+test('the agenda fills 60 minutes: warm-up, focus blocks, games, review', () => {
+  const plan = planSession({ sessionDate: '2026-09-29', weakest: THREE, puzzles: PUZZLES });
+  assert.deepEqual(plan.agenda.map((a) => a.kind), ['warmup', 'focus', 'focus', 'focus', 'games', 'review']);
+  assert.equal(plan.agenda.reduce((sum, a) => sum + a.minutes, 0), 60);
+  plan.agenda.forEach((item, i) => {
+    assert.equal(item.start, i === 0 ? 0 : plan.agenda[i - 1].end);
+    assert.equal(item.end - item.start, item.minutes);
+  });
+  assert.deepEqual(plan.agenda.map((a) => a.minutes), [10, 7, 7, 6, 20, 10]);
+  assert.equal(plan.warmup.minutes, 10);
+  assert.deepEqual(plan.focuses.map((f) => f.minutes), [7, 7, 6]);
+  // The practice games carry the weakest category's game tip.
+  assert.ok(plan.agenda[4].detail.includes(CATEGORY_LESSONS.endgameTechnique.gameTip));
+});
+
+test('buildAgenda scales and rejects nonsense lengths', () => {
+  const focuses = [{ label: 'A', focus: 'a' }, { label: 'B', focus: 'b' }];
+  assert.equal(buildAgenda(focuses, { minutes: 90 }).at(-1).end, 90);
+  assert.equal(buildAgenda(focuses, { minutes: 45 }).at(-1).end, 45);
+  for (const minutes of [0, 20, 29, 181, 60.5, '60', NaN]) {
+    assert.throws(() => buildAgenda(focuses, { minutes }), RangeError, String(minutes));
+  }
+  assert.throws(() => buildAgenda([], {}), TypeError);
+});
+
+/* ── fewer than three measured: say so, do not invent ────────────────────── */
+
+test('one measured category: one focus on it, two labelled general tactics, and a note saying so', () => {
+  const plan = planSession({ sessionDate: '2026-09-29', weakest: [THREE[0]], puzzles: PUZZLES });
+  assert.equal(plan.measuredCount, 1);
+  assert.deepEqual(plan.focuses.map((f) => f.kind), ['measured', 'general', 'general']);
+  assert.equal(plan.focuses[0].category, 'endgameTechnique');
+  for (const f of plan.focuses.slice(1)) {
+    assert.equal(f.category, null);
+    assert.equal(f.rubricAverage, null);
+    assert.match(f.label, /^General tactics/);
+  }
+  assert.match(plan.note, /Only 1 category has enough measured data/);
+  assert.match(plan.note, /2 blocks are general tactics, not a measured weakness/);
+});
+
+test('no measured categories: all general tactics, and the note says it is not a diagnosis', () => {
+  for (const weakest of [[], null, undefined, 'endgame', {}]) {
+    const plan = planSession({ sessionDate: '2026-09-29', weakest, puzzles: PUZZLES });
+    assert.equal(plan.measuredCount, 0);
+    assert.ok(plan.focuses.every((f) => f.kind === 'general' && f.category === null));
+    assert.equal(plan.focuses.length, 3);
+    assert.match(plan.note, /not a diagnosis/);
+    assert.equal(plan.agenda.reduce((sum, a) => sum + a.minutes, 0), 60);
+  }
+});
+
+test('an unmeasured, unknown, notation or duplicate entry is never treated as a weakness', () => {
+  const plan = planSession({
+    sessionDate: '2026-09-29',
+    puzzles: PUZZLES,
+    weakest: [
+      { category: 'tacticalVision', label: 'Tactical vision', average: null, rubricAverage: null },
+      { category: 'notation', label: 'Notation', average: 10, rubricAverage: 1 },
+      { category: 'swagger', label: 'Swagger', average: 5 },
+      entry('boardVision', 38, 'Board vision'),
+      entry('boardVision', 38, 'Board vision'),
+      null,
+    ],
+  });
+  assert.equal(plan.measuredCount, 1);
+  assert.deepEqual(plan.focuses.map((f) => f.category), ['boardVision', null, null]);
+});
+
+test('the planner accepts weakestCategories(clubProfile(...)) as it comes', () => {
+  const players = [
+    { playerId: 'CC-010', rubric: {} },
+    { playerId: 'CC-011', rubric: {} },
+  ];
+  const skills = {
+    'CC-010': {
+      endgameTechnique: { score: 30, confidence: 'medium', observations: 40 },
+      timeManagement: { score: 70, confidence: 'high', observations: 90 },
+      tacticalVision: { score: 55, confidence: 'low', observations: 3 }, // too thin to count
+    },
+    'CC-011': { endgameTechnique: { score: 40, confidence: 'medium', observations: 30 } },
+  };
+  const weakest = weakestCategories(clubProfile(players, skills));
+  assert.deepEqual(weakest.map((w) => w.category), ['endgameTechnique', 'timeManagement']);
+  const plan = planSession({ sessionDate: '2026-09-29', weakest, puzzles: PUZZLES });
+  assert.deepEqual(plan.focuses.map((f) => f.kind), ['measured', 'measured', 'general']);
+  assert.equal(plan.focuses[0].label, 'Endgame technique');
+  assert.equal(plan.focuses[0].rubricAverage, 3.5);
+  assert.match(plan.note, /Only 2 categories/);
+});
+
+/* ── running out of puzzles ──────────────────────────────────────────────── */
+
+test('when a theme runs out, repeats from last week are flagged rather than hidden', () => {
+  // A tiny library: seven opening puzzles and a few warm-ups.
+  const tiny = [
+    ...Array.from({ length: 7 }, (_, i) => ({ id: `op${i}`, rating: 800 + i * 100, themes: ['opening'], name: 'Opening' })),
+    ...Array.from({ length: 12 }, (_, i) => ({ id: `w${i}`, rating: 500 + i * 10, themes: ['mateIn1', 'oneMove'] })),
+    ...Array.from({ length: 30 }, (_, i) => ({ id: `t${i}`, rating: 600 + i * 30, themes: ['fork', 'pin', 'backRankMate'] })),
+  ];
+  const weakest = [entry('openingKnowledge', 40, 'Opening knowledge')];
+  const first = planSession({ sessionDate: '2026-09-29', weakest, puzzles: tiny });
+  assert.equal(first.focuses[0].puzzles.length, 6);
+  assert.equal(first.focuses[0].note, null);
+
+  const second = planSession({ sessionDate: '2026-10-06', weakest, puzzles: tiny, previousPlan: first });
+  const opening = second.focuses[0];
+  assert.equal(opening.puzzles.length, MIN_PUZZLES_PER_FOCUS);
+  assert.equal(opening.puzzles.filter((p) => p.repeated).length, 4);
+  assert.match(opening.note, /4 puzzles repeat from the last plan/);
+  const ratings = opening.puzzles.map((p) => p.rating);
+  assert.deepEqual(ratings, [...ratings].sort((a, b) => a - b));
+});
+
+test('a theme with too few puzzles says how many it has', () => {
+  const tiny = [
+    { id: 'op1', rating: 900, themes: ['opening'] },
+    { id: 'op2', rating: 1000, themes: ['opening'] },
+    ...Array.from({ length: 40 }, (_, i) => ({ id: `t${i}`, rating: 500 + i * 30, themes: ['fork', 'pin', 'mateIn2', 'oneMove'] })),
+  ];
+  const plan = planSession({ sessionDate: '2026-09-29', weakest: [entry('openingKnowledge', 40)], puzzles: tiny });
+  assert.equal(plan.focuses[0].puzzles.length, 2);
+  assert.match(plan.focuses[0].note, /Only 2 puzzles in the library/);
+});
+
+/* ── bad input ───────────────────────────────────────────────────────────── */
+
+test('bad input is refused, not guessed at', () => {
+  assert.throws(() => planSession({ sessionDate: '29/09/2026', weakest: THREE, puzzles: PUZZLES }), TypeError);
+  assert.throws(() => planSession({ sessionDate: '2026-02-30', weakest: THREE, puzzles: PUZZLES }), TypeError);
+  assert.throws(() => planSession({ sessionDate: '2026-09-29', weakest: THREE }), TypeError);
+  assert.throws(() => planSession({ sessionDate: '2026-09-29', weakest: THREE, puzzles: 'all' }), TypeError);
+  for (const puzzlesPerFocus of [4, 9, 6.5, '6']) {
+    assert.throws(
+      () => planSession({ sessionDate: '2026-09-29', weakest: THREE, puzzles: PUZZLES, puzzlesPerFocus }),
+      RangeError,
+      String(puzzlesPerFocus),
+    );
+  }
+  assert.throws(() => planSession({ sessionDate: '2026-09-29', puzzles: PUZZLES, minutes: 5 }), RangeError);
+  assert.throws(() => planSession(), TypeError);
+});
+
+test('malformed puzzles in the library are skipped, not crashed on', () => {
+  const plan = planSession({
+    sessionDate: '2026-09-29',
+    weakest: THREE,
+    puzzles: [null, { id: 'x' }, { id: 7, themes: ['opening'], rating: 900 }, ...PUZZLES],
+  });
+  assert.ok(allPuzzles(plan).every((p) => byId.has(p.id)));
+});
+
+/* ── helpers ─────────────────────────────────────────────────────────────── */
+
+test('puzzleIdsInPlan tolerates old or broken plans', () => {
+  assert.equal(puzzleIdsInPlan(null).size, 0);
+  assert.equal(puzzleIdsInPlan('plan').size, 0);
+  assert.equal(puzzleIdsInPlan({ focuses: 'x', warmup: { puzzles: [null, { id: 3 }, { id: 'a' }] } }).size, 1);
+});
+
+test('spreadAcross picks distinct, evenly spaced items', () => {
+  const sorted = Array.from({ length: 10 }, (_, i) => i);
+  assert.deepEqual(spreadAcross(sorted, 4), [0, 3, 6, 9]);
+  assert.deepEqual(spreadAcross(sorted, 1), [4]);
+  assert.deepEqual(spreadAcross(sorted, 0), []);
+  assert.deepEqual(spreadAcross([1, 2], 5), [1, 2]);
+  const many = spreadAcross(Array.from({ length: 9 }, (_, i) => i), 8);
+  assert.equal(new Set(many).size, 8);
+});
+
+test('theme labels and links read like the Training page', () => {
+  assert.equal(themeLabel('discoveredAttack'), 'Discovered attack');
+  assert.equal(themeLabel('mateIn1'), 'Mate in 1');
+  assert.equal(themeLabel('endgame'), 'Endgame');
+  assert.equal(trainingHref('backRankMate'), '#/training?theme=backRankMate');
+});
